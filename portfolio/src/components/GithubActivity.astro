---
import type { GithubStats } from '../data/github';

/** GitHub activity: totals, a contributions heatmap and monthly bars, from data fetched at build time. */
interface Props {
  stats: GithubStats;
}
const { stats } = Astro.props;
const n = new Intl.NumberFormat('en-IN');
const dayFmt = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
const monthFmt = new Intl.DateTimeFormat('en-GB', { month: 'short', timeZone: 'UTC' });
const maxMonth = Math.max(1, ...stats.months.map((m) => m.count));
const busiestMonth = stats.months.reduce((a, b) => (b.count > a.count ? b : a), stats.months[0]);
// Month labels above the heatmap: show a label on the first week that starts in a new month.
const monthLabels = stats.weeks.map((w, i) => {
  const m = w[0].date.slice(0, 7);
  const prev = i > 0 ? stats.weeks[i - 1][0].date.slice(0, 7) : '';
  return m !== prev && i < stats.weeks.length - 1 ? monthFmt.format(new Date(`${w[0].date}T00:00:00Z`)) : '';
});
const plural = (v: number, s: string) => `${n.format(v)} ${s}${v === 1 ? '' : 's'}`;
---
<div class="gh">
  <div class="gh-left">
    <div class="ui-card lg total" data-reveal>
      <p class="label">Last 12 months</p>
      <p class="big" data-count={stats.total}>{n.format(stats.total)}</p>
      <p class="muted">contributions on GitHub</p>
      <div class="sub">
        <div><b>{stats.busiest.count} · {dayFmt.format(new Date(`${stats.busiest.date}T00:00:00Z`))}</b><span class="label">Busiest day</span></div>
        <div><b>{plural(stats.longestStreak, 'day')}</b><span class="label">Longest streak</span></div>
      </div>
    </div>
    <div class="ui-grid minis" data-reveal>
      <a class="ui-card mini" href={`${stats.url}?tab=repositories&sort=stargazers`} rel="noopener" data-cursor="Stars">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.9 6.8 19.6l1-5.8-4.3-4.1 5.9-.9z" /></svg>
        <b>{n.format(stats.stars)}</b><span class="label">Stars</span>
      </a>
      <a class="ui-card mini" href={`${stats.url}?tab=followers`} rel="noopener" data-cursor="Follow">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="8" r="3.5" /><path d="M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6" /><path d="M16 4.5a3.5 3.5 0 0 1 0 7M18 14.3c1.8.8 3 2.6 3 4.7" /></svg>
        <b>{n.format(stats.followers)}</b><span class="label">Followers</span>
      </a>
      <a class="ui-card mini" href={`${stats.url}?tab=repositories&type=source`} rel="noopener" data-cursor="Repos">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="6" cy="5" r="2" /><circle cx="18" cy="5" r="2" /><circle cx="12" cy="19" r="2" /><path d="M6 7v2a3 3 0 0 0 3 3h6a3 3 0 0 0 3-3V7M12 12v5" /></svg>
        <b>{n.format(stats.repos)}</b><span class="label">Repos</span>
      </a>
    </div>
  </div>

  <div class="ui-card lg board" data-reveal>
    <div class="bhead">
      <a href={stats.url} rel="noopener" class="who" data-cursor="GitHub">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 19c-4.3 1.4-4.3-2.5-6-3m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12.3 12.3 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21" /></svg>
        @{stats.user}
      </a>
      <span class="pill updated"><span class="dot"></span>Updated {stats.fetchedAt}</span>
      <a class="label view" href={stats.url} rel="noopener">View profile ↗</a>
    </div>

    <div class="heat-scroll" tabindex="0" role="region" aria-label={`Contribution heatmap, ${plural(stats.total, 'contribution')} in the last year`}>
      <div class="heat" style={`--weeks:${stats.weeks.length}`}>
        <div class="months" aria-hidden="true">{monthLabels.map((m) => <span>{m}</span>)}</div>
        <div class="days" aria-hidden="true"><span></span><span>Mon</span><span></span><span>Wed</span><span></span><span>Fri</span><span></span></div>
        <div class="grid">
          {stats.weeks.map((w, wi) => (
            <div class="week" style={wi === 0 ? `grid-row-start:${8 - w.length}` : undefined}>
              {w.map((d) => <i class={`l${d.level}`} title={`${plural(d.count, 'contribution')} on ${dayFmt.format(new Date(`${d.date}T00:00:00Z`))}`}></i>)}
            </div>
          ))}
        </div>
      </div>
    </div>
    <div class="legend"><span class="label">Last 12 months · from GitHub</span><span class="scale label">Less <i class="l0"></i><i class="l1"></i><i class="l2"></i><i class="l3"></i><i class="l4"></i> More</span></div>

    <div class="months-head"><p class="label">Contributions by month</p><p class="label">Busiest: <b>{busiestMonth.label}</b> · {busiestMonth.count}</p></div>
    <div class="mbars">
      {stats.months.map((m) => (
        <div class="mbar" title={`${m.label}: ${plural(m.count, 'contribution')}`}>
          <span class="col"><i style={`--h:${Math.max(3, (m.count / maxMonth) * 100)}%`}></i></span>
          <span class="label">{m.label}</span>
        </div>
      ))}
    </div>
  </div>
</div>

<style>
  .gh { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.6fr); gap: var(--gap-grid); align-items: stretch; }
  .gh-left { display: grid; gap: var(--gap-grid); grid-template-rows: 1fr auto; }
  .total { display: flex; flex-direction: column; }
  .big { font: 600 clamp(64px, 7vw, 104px)/1 var(--font-display); letter-spacing: -.05em; margin: 18px 0 8px; font-variant-numeric: tabular-nums; }
  .sub { margin-top: auto; padding-top: 24px; border-top: 1px solid var(--line); display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .sub b { display: block; font-weight: 500; font-size: 17px; margin-bottom: 4px; }
  .minis { grid-template-columns: repeat(3, 1fr); }
  .mini { display: grid; gap: 6px; padding: 20px; }
  .mini svg { width: 20px; height: 20px; fill: none; stroke: var(--accent); stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
  .mini b { font: 600 clamp(28px, 2.6vw, 36px)/1 var(--font-display); letter-spacing: -.03em; margin-top: 8px; }

  .bhead { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; margin-bottom: 22px; }
  .who { display: inline-flex; align-items: center; gap: 10px; font: 600 20px var(--font-display); letter-spacing: -.02em; }
  .who svg { width: 22px; height: 22px; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
  .updated { font-size: 12px; }
  .view { margin-left: auto; }
  .view:hover { color: var(--text); }

  .heat-scroll { overflow-x: auto; padding-bottom: 6px; }
  .heat { --cell: 11px; --gap: 3px; display: grid; grid-template-columns: 30px auto; grid-template-rows: auto auto; gap: 6px 6px; min-width: max-content; }
  .months { grid-column: 2; display: grid; grid-template-columns: repeat(var(--weeks), var(--cell)); column-gap: var(--gap); font: 11px var(--font-mono); color: var(--text-3); }
  .months span { white-space: nowrap; overflow: visible; }
  .days { grid-column: 1; grid-row: 2; display: grid; grid-template-rows: repeat(7, var(--cell)); row-gap: var(--gap); font: 10px/var(--cell) var(--font-mono); color: var(--text-3); }
  .grid { grid-column: 2; grid-row: 2; display: grid; grid-auto-flow: column; grid-template-columns: repeat(var(--weeks), var(--cell)); column-gap: var(--gap); }
  .week { display: grid; grid-template-rows: repeat(7, var(--cell)); row-gap: var(--gap); align-content: start; }
  .grid i, .scale i { width: var(--cell, 11px); height: var(--cell, 11px); border-radius: 3px; display: block; }
  .l0 { background: var(--surface-3); }
  .l1 { background: color-mix(in srgb, var(--accent) 30%, var(--surface-3)); }
  .l2 { background: color-mix(in srgb, var(--accent) 55%, var(--surface-3)); }
  .l3 { background: color-mix(in srgb, var(--accent) 78%, var(--surface-3)); }
  .l4 { background: var(--accent); }
  .legend { display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; margin-top: 14px; }
  .scale { display: inline-flex; align-items: center; gap: 4px; }
  .scale i { --cell: 10px; }

  .months-head { display: flex; justify-content: space-between; gap: 12px; margin-top: 28px; padding-top: 24px; border-top: 1px solid var(--line); }
  .months-head b { color: var(--text); font-weight: 500; }
  .mbars { display: grid; grid-template-columns: repeat(12, 1fr); gap: 8px; align-items: end; height: 170px; margin-top: 18px; }
  .mbar { display: grid; grid-template-rows: 1fr auto; gap: 8px; height: 100%; text-align: center; }
  .col { display: flex; align-items: flex-end; }
  .col i { width: 100%; height: var(--h); border-radius: 8px 8px 3px 3px; background: color-mix(in srgb, var(--accent) 70%, var(--surface-3)); transition: background var(--t-fast); }
  .mbar:hover .col i { background: var(--accent); }
  @media (max-width: 1000px) { .gh { grid-template-columns: 1fr; } }
  @media (max-width: 560px) { .minis { grid-template-columns: 1fr 1fr 1fr; } .mini { padding: 16px; } .mbars { gap: 4px; } }
</style>
