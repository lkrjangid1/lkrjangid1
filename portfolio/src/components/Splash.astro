---
import { site } from '../data/site';

/**
 * Intro splash on the home page: the handle is built from falling colour ribbons, a glint passes, it
 * pulses once and the camera dives into the "j". Pure CSS, so it plays (and ends) without JS.
 * theme-init.js hides it after the first view in a session; it is skipped for reduced motion,
 * and site.ts lets a click or key press dismiss it early.
 */
const N = 26;
const W = 1000;
const palette = ['#3db9ff', '#2a8dff', '#5fd0ff', '#1f6bff', '#7cc8ff', '#3a7bff', '#49e0ff'];
// Deterministic pseudo-random stagger so the build looks hand-made but never changes between deploys.
const ribbons = Array.from({ length: N }, (_, i) => ({
  x: (W / N) * i,
  w: W / N + 0.6,
  fill: palette[(i * 5) % palette.length],
  d: 80 + ((i * 37) % 23) * 20,
  y0: ((i * 53) % 2 ? -1 : 1) * (60 + ((i * 29) % 40)),
}));
const streaks = Array.from({ length: 14 }, (_, i) => ({ a: (360 / 14) * i + ((i * 17) % 11), d: 1680 + ((i * 13) % 7) * 18 }));
---
<div class="splash" aria-hidden="true" data-splash>
  <div class="sp-stage"></div>
  <div class="sp-bloom"></div>
  <div class="sp-center">
    <div class="sp-box">
      <div class="sp-halo"></div>
      <svg class="sp-word" viewBox={`0 0 ${W} 260`} preserveAspectRatio="xMidYMid meet">
        <defs>
          <clipPath id="sp-clip">
            <text x={W / 2} y="200" text-anchor="middle" textLength={W - 20} lengthAdjust="spacingAndGlyphs">{site.handle}</text>
          </clipPath>
          <linearGradient id="sp-glint" x1="0" x2="1">
            <stop offset="0" stop-color="#fff" stop-opacity="0" />
            <stop offset=".5" stop-color="#fff" stop-opacity=".75" />
            <stop offset="1" stop-color="#fff" stop-opacity="0" />
          </linearGradient>
        </defs>
        <g clip-path="url(#sp-clip)">
          {ribbons.map((r) => <rect class="sp-ribbon" x={r.x} y="0" width={r.w} height="260" fill={r.fill} style={`--d:${r.d}ms;--y0:${r.y0}px`} />)}
          <rect class="sp-glint" x="-260" y="-40" width="220" height="340" fill="url(#sp-glint)" />
        </g>
      </svg>
    </div>
  </div>
  <div class="sp-streaks">{streaks.map((s) => <i style={`--a:${s.a}deg;--d:${s.d}ms`}></i>)}</div>
</div>

<style>
  .splash { position: fixed; inset: 0; z-index: 9999; overflow: hidden; cursor: pointer; animation: sp-end 1ms linear 2450ms forwards; }
  :global(.splash-seen) .splash { display: none; }
  @media (prefers-reduced-motion: reduce) { .splash { display: none; } }
  .splash.skip { animation: sp-out 280ms ease forwards; pointer-events: none; }
  .splash.skip * { animation-play-state: paused; }

  .sp-stage { position: absolute; inset: 0; background: #000; animation: sp-out 420ms cubic-bezier(.4, 0, .2, 1) 1950ms forwards; }
  .sp-bloom {
    position: absolute; left: 39%; top: 53%; width: 120vmax; height: 120vmax; margin: -60vmax 0 0 -60vmax; border-radius: 50%;
    background: radial-gradient(closest-side, rgb(61 185 255 / .5), rgb(31 107 255 / .22) 40%, transparent 72%);
    opacity: 0; transform: scale(.4); animation: sp-bloom 760ms cubic-bezier(.2, .7, .3, 1) 1680ms forwards;
  }
  .sp-center { position: absolute; inset: 0; display: grid; place-items: center; }
  .sp-box {
    position: relative; width: min(calc(100vw - 48px), 860px); aspect-ratio: 1000 / 260; transform-origin: 31.5% 64%;
    animation: sp-tadum 520ms cubic-bezier(.3, 0, .2, 1) 1150ms both, sp-zoom 720ms cubic-bezier(.6, 0, .9, .5) 1680ms forwards;
  }
  .sp-halo {
    position: absolute; left: 50%; top: 50%; width: 130%; aspect-ratio: 2.4; translate: -50% -50%; border-radius: 50%; opacity: 0;
    background: radial-gradient(closest-side, rgb(61 185 255 / .3), rgb(31 107 255 / .1) 55%, transparent 78%);
    animation: sp-fade 1000ms cubic-bezier(.22, 1, .36, 1) 260ms forwards;
  }
  .sp-word { position: relative; display: block; width: 100%; height: 100%; overflow: visible; }
  .sp-word text { font: 600 236px/1 var(--font-display); letter-spacing: -.04em; }
  .sp-ribbon { opacity: 0; transform-box: fill-box; transform-origin: 50% 0; animation: sp-in 760ms cubic-bezier(.16, 1, .3, 1) var(--d) forwards; }
  .sp-glint { transform-box: view-box; animation: sp-glint 760ms cubic-bezier(.4, 0, .2, 1) 1000ms forwards; }

  .sp-streaks { position: absolute; left: 39%; top: 53%; }
  .sp-streaks i {
    position: absolute; left: 0; top: 0; width: 34vmax; height: 2px; margin-top: -1px; transform-origin: 0 50%; opacity: 0;
    background: linear-gradient(90deg, rgb(95 208 255 / 0), rgb(95 208 255 / .9) 55%, rgb(200 236 255 / 0));
    transform: rotate(var(--a)) translateX(4vmax) scaleX(.1);
    animation: sp-streak 600ms cubic-bezier(.55, 0, .8, .4) var(--d) forwards;
  }

  @keyframes sp-in {
    0% { opacity: 0; transform: translateY(var(--y0)) scaleY(.2); }
    35% { opacity: 1; }
    100% { opacity: 1; transform: none; }
  }
  @keyframes sp-glint { from { transform: translateX(0) skewX(-16deg); } to { transform: translateX(1500px) skewX(-16deg); } }
  @keyframes sp-tadum { 0%, 100% { scale: 1; } 45% { scale: 1.04; } }
  @keyframes sp-zoom { 0% { transform: scale(1); opacity: 1; } 72% { opacity: 1; } 100% { transform: scale(22); opacity: 0; } }
  @keyframes sp-fade { to { opacity: 1; } }
  @keyframes sp-out { to { opacity: 0; } }
  @keyframes sp-end { to { visibility: hidden; pointer-events: none; } }
  @keyframes sp-bloom { 0% { opacity: 0; transform: scale(.4); } 35% { opacity: .95; } 100% { opacity: 0; transform: scale(1.5); } }
  @keyframes sp-streak {
    0% { opacity: 0; transform: rotate(var(--a)) translateX(4vmax) scaleX(.1); }
    30% { opacity: 1; }
    100% { opacity: 0; transform: rotate(var(--a)) translateX(70vmax) scaleX(1); }
  }
</style>
