---
import AppIcon from './AppIcon.astro';
import { Image } from 'astro:assets';
import ShowcaseArt from './ShowcaseArt.astro';
import ShowcaseBg from './ShowcaseBg.astro';
import { clock, showcaseMedia } from '../data/showcase';
import { brand } from '../data/icons';
import type { ReelItem } from '../data/home';

/**
 * Full-screen product showcase. On wide screens with motion allowed, site.ts pins the stage and scrubs
 * every transition with the scroll position: the next slide is a circle growing out of its app icon. Without that it is a
 * plain stack of full-height sections, so content, links and headings never depend on JS.
 * Each visual is a film poster; site.ts opens the film in a dialog that grows out of the poster (without JS the
 * poster is a plain link to the mp4).
 */
interface Props { items: ReelItem[] }
const { items } = Astro.props;
const total = String(items.length).padStart(2, '0');
const host = (url: string) => { try { return new URL(url).hostname.replace(/^www\./, ''); } catch { return ''; } };
---
<section id="work" class="show" style={`--n:${items.length}`} aria-labelledby="work-h" data-show>
  <h2 id="work-h" class="sr-only">Featured Flutter apps and tools</h2>
  <div class="show-stage">
    {items.map((r, i) => {
      const m = showcaseMedia[r.slug];
      const site = r.links.find((l) => /website|docs|live|web/i.test(l.label)) ?? r.links[0];
      return (
        <article id={`p-${r.slug}`} class:list={['slide', { on: i === 0 }]} style={`--app:${brand(r.slug, r.name).accent};--i:${i}`} data-index={i} aria-labelledby={`p-${r.slug}-h`}>
          <div class="slide-bg" aria-hidden="true"><ShowcaseBg slug={r.slug} /></div>
          <div class="wrap slide-inner">
            <div class="slide-copy">
              <div class="slide-head">
                <AppIcon slug={r.slug} name={r.name} size={76} class="slide-icon" />
                <div class="s-in">
                  <span class="label slide-n">{String(i + 1).padStart(2, '0')} / {total}</span>
                  <span class="pill">{r.platform}</span>
                </div>
              </div>
              <h3 id={`p-${r.slug}-h`} class="display slide-name s-in">{r.name}</h3>
              <p class="serif slide-tag s-in">{r.tagline}</p>
              <p class="slide-desc s-in">{r.points[0]}</p>
              {r.metrics.length > 0 && <ul class="slide-chips s-in">{r.metrics.slice(0, 4).map((m) => <li>{m}</li>)}</ul>}
              <div class="slide-cta s-in">
                <a class="btn btn-primary" href={r.href} data-cursor="Read">Case study ↗</a>
                {site && <a class="mono slide-link" href={site.url} rel="noopener" data-cursor="Visit">{host(site.url) || site.label}</a>}
              </div>
            </div>
            <div class="slide-visual">
              {m && (
                <div class="sv">
                  <a class="sv-play" href={m.video} data-film={m.video} data-film-title={r.name} data-film-href={r.href} data-cursor="Play" aria-label={`Play the ${r.name} film (${clock(m.duration)})`}>
                    <Image class:list={['sv-thumb', { 'sv-dark': m.thumbLight }]} src={m.thumb} alt="" widths={[640, 960, 1280, 1920]} sizes="(max-width: 900px) 92vw, 52vw" format="webp" quality={82} loading={i === 0 ? 'eager' : 'lazy'} />
                    {m.thumbLight && <Image class="sv-thumb sv-light" src={m.thumbLight} alt="" widths={[640, 960, 1280, 1920]} sizes="(max-width: 900px) 92vw, 52vw" format="webp" quality={82} loading="lazy" />}
                    <span class="sv-btn" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 5.6v12.8a1 1 0 0 0 1.5.86l10.4-6.4a1 1 0 0 0 0-1.72L9.5 4.74A1 1 0 0 0 8 5.6z" /></svg></span>
                    <span class="sv-dur mono" aria-hidden="true">▶ Watch · {clock(m.duration)}</span>
                  </a>
                  <ShowcaseArt slug={r.slug} chip={r.metrics[0]} />
                </div>
              )}
            </div>
          </div>
        </article>
      );
    })}

    <nav class="show-rail" aria-label="Featured products">
      <span class="label" data-show-n>01</span>
      <i aria-hidden="true"></i>
      {items.map((r, i) => (
        <a href={`#p-${r.slug}`} class:list={['show-dot', { on: i === 0 }]} data-go={i} aria-label={r.name} data-tip={r.name}>
          <AppIcon slug={r.slug} name={r.name} size={34} />
        </a>
      ))}
      <i aria-hidden="true"></i>
      <span class="label">{total}</span>
    </nav>
    <div class="show-progress" aria-hidden="true"><i></i></div>
  </div>
  <dialog class="film" aria-label="Product film" data-film-dialog>
    <div class="film-box">
      <div class="film-frame">
        <video playsinline controls preload="none"></video>
        <img class="film-poster" alt="" />
      </div>
      <div class="film-bar">
        <b class="film-title"></b>
        <a class="film-link" href="/work">Case study ↗</a>
        <button class="film-close" type="button" aria-label="Close video" data-film-close>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
        </button>
      </div>
    </div>
  </dialog>
</section>
