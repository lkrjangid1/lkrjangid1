---
import { Image } from 'astro:assets';
import { brand } from '../data/icons';

interface Props {
  slug: string;
  name?: string;
  size?: number;
  class?: string;
  label?: boolean;
}

const { slug, name = slug, size = 56, class: className, label = false } = Astro.props;
const b = brand(slug, name);
// Bare logo marks (no tile of their own) sit inset on their configured tile colour.
const padded = !!(b.icon && b.tile);
---
<span
  class:list={['app-icon', className, { 'has-img': b.icon, padded }]}
  style={`--app:${b.accent};--size:${size}px${padded ? `;--tile:${b.tile}` : ''}`}
  role={label ? 'img' : undefined}
  aria-label={label ? name : undefined}
  aria-hidden={label ? undefined : 'true'}
>
  {b.icon ? <Image src={b.icon} alt="" width={size * 2} height={size * 2} format={b.icon.format === 'svg' ? 'svg' : 'webp'} loading="lazy" /> : b.mono}
</span>

<style>
  /* One elevation for every icon (image or monogram): neutral shadow plus a hairline edge ring,
     so white, dark and coloured icons all sit at the same height. */
  .app-icon { position: relative; box-shadow: var(--icon-shadow); }
  .app-icon::after { content: ''; position: absolute; inset: 0; border-radius: inherit; box-shadow: var(--icon-ring); pointer-events: none; }
  .has-img { background: transparent; overflow: hidden; }
  .has-img :global(img) { width: 100%; height: 100%; object-fit: cover; border-radius: inherit; }
  /* Padding from the icon size, not %, which would resolve against the parent's width. */
  .padded { background: var(--tile); padding: calc(var(--size) * .16); }
  .padded :global(img) { object-fit: contain; border-radius: 0; }
</style>
