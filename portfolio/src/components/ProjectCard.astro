---
import AppIcon from './AppIcon.astro';
import Shot from './Shot.astro';
import type { ShotSrc } from '../data/home';
import { brand } from '../data/icons';

interface Props {
  slug: string;
  href: string;
  title: string;
  subtitle?: string;
  meta?: string;
  metric?: string;
  tags: string[];
  category: string;
  status?: string;
  shot?: ShotSrc;
  external?: boolean;
  featured?: boolean;
}

const { slug, href, title, subtitle, meta, metric, tags, category, status, shot, external = false, featured = false } = Astro.props;
const search = [title, subtitle, meta, metric, status, ...tags].filter(Boolean).join(' ').toLowerCase();
const portrait = shot && typeof shot !== 'string' && shot.height > shot.width * 1.2;
---
<article class:list={['pcard', { featured, 'has-shot': shot }]} style={`--app:${brand(slug, title).accent}`} data-category={category} data-search={search} data-tilt>
  <div class="pcard-body">
    <div class="pcard-head">
      <AppIcon slug={slug} name={title} size={44} />
      {status && <span class="pill">{status}</span>}
    </div>
    <a href={href} class="stretched" rel={external ? 'noopener' : undefined}><h3 class="h3">{title}</h3></a>
    {subtitle && <p class="muted sub">{subtitle}</p>}
    {meta && <p class="label meta">{meta}</p>}
    {metric && <p class="metric">{metric}</p>}
    <div class="tags">{tags.slice(0, 4).map((t) => <span class="chip">{t}</span>)}</div>
  </div>
  {shot && <div class:list={['thumb', { portrait }]}><Shot src={shot} alt="" width={portrait ? 360 : 640} /></div>}
  <span class="go" aria-hidden="true">{external ? '↗' : '→'}</span>
</article>

<style>
  .pcard {
    position: relative; display: flex; flex-direction: column; overflow: hidden; min-height: 300px;
    border-radius: 24px; background: var(--surface); border: 1px solid var(--line);
    transition: border-color var(--t-fast), transform var(--t-med) var(--ease-out);
  }
  .pcard::before { content: ''; position: absolute; inset: 0; pointer-events: none; background: radial-gradient(90% 70% at 100% 0%, color-mix(in srgb, var(--app) 14%, transparent), transparent 60%); }
  .pcard:hover { border-color: color-mix(in srgb, var(--app) 45%, var(--line)); }
  .pcard:has(.stretched:focus-visible) { outline: 2px solid var(--accent); outline-offset: 3px; }
  .featured { border-color: color-mix(in srgb, var(--accent) 50%, var(--line)); }
  .pcard-body { position: relative; display: flex; flex-direction: column; gap: 8px; padding: 24px 24px 20px; }
  .pcard-head { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 6px; }
  .stretched::after { content: ''; position: absolute; inset: 0; z-index: 2; }
  .stretched:focus-visible { outline: none; }
  .sub { font-size: 15px; line-height: 1.5; }
  .metric { font: 500 13.5px/1.45 var(--font-mono); color: color-mix(in srgb, var(--app) 75%, var(--text)); }
  .tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 6px; }
  .thumb { position: relative; margin-top: auto; height: 170px; overflow: hidden; padding: 0 24px; }
  .thumb :global(img) {
    width: 100%; height: auto; border-radius: 12px 12px 0 0; border: 1px solid var(--line-2); border-bottom: 0;
    transition: transform var(--t-slow) var(--ease-out);
  }
  .thumb.portrait { display: flex; justify-content: center; align-items: flex-start; }
  .thumb.portrait :global(img) { width: 46%; border-radius: 18px 18px 0 0; }
  .pcard:hover .thumb :global(img) { transform: translateY(-8px); }
  .go { position: absolute; right: 22px; top: 22px; z-index: 1; color: var(--text-3); font-size: 18px; transition: transform var(--t-fast), color var(--t-fast); }
  .pcard:has(.pill) .go { display: none; }
  .pcard:hover .go { color: var(--app); transform: translateX(3px); }
</style>
