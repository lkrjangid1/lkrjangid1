---
import Icon from './Icon.astro';
import { site } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="container footer-inner">
    <span>© {year} {site.name}</span>
    <nav class="social" aria-label="Elsewhere">
      <a href={site.links.github} rel="me noopener"><Icon name="github" /> GitHub</a>
      <a href={site.links.linkedin} rel="me noopener"><Icon name="linkedin" /> LinkedIn</a>
      <a href={site.links.x} rel="me noopener"><Icon name="brand-x" /> X</a>
      <a href={site.links.pubdev} rel="me noopener"><Icon name="package" /> pub.dev</a>
      <a href="/contact"><Icon name="mail" /> Email</a>
    </nav>
  </div>
</footer>

<style>
  .footer { margin-top: var(--space-16); border-top: 1px solid var(--border); }
  .footer-inner {
    display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;
    padding-top: 20px; padding-bottom: 32px; font-size: 13px; color: var(--text-muted);
  }
  .social { display: flex; flex-wrap: wrap; gap: 4px 16px; }
  .social a { display: inline-flex; align-items: center; gap: 6px; color: var(--text-muted); text-decoration: none; }
  .social a:hover { color: var(--text-primary); }
</style>
