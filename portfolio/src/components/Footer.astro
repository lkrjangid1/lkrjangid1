---
import { site } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="footer wrap">
  <span>© {year} {site.name}</span>
  <span class="status"><span class="dot"></span> {site.availability}</span>
  <nav class="links" aria-label="Elsewhere">
    <a href={site.links.github} rel="me noopener">GitHub</a>
    <a href={site.links.linkedin} rel="me noopener">LinkedIn</a>
    <a href={site.links.x} rel="me noopener">X</a>
    <a href={site.links.pubdev} rel="me noopener">pub.dev</a>
    <a href={site.links.blog} rel="me noopener">FlutDev</a>
    <a href={`mailto:${site.email}`}>Email</a>
  </nav>
</footer>

<style>
  .footer {
    display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 14px 24px;
    padding-top: 32px; padding-bottom: 40px; margin-top: 96px; border-top: 1px solid var(--line); font-size: 14px; color: var(--text-3);
  }
  .status { display: inline-flex; align-items: center; gap: 10px; }
  .links { display: flex; flex-wrap: wrap; gap: 6px 18px; }
  .links a:hover { color: var(--text); }
</style>
