---
import Base from '../layouts/Base.astro';
---
<Base title="Not found" description="This page moved or never existed." noindex>
  <div class="wrap nf">
    <div class="page-glow" aria-hidden="true"></div>
    <p class="mono muted">$ why-skipped '<span id="path">/this-page</span>'</p>
    <h1 class="display big">404</h1>
    <p class="serif accent tag">This page was never generated.</p>
    <p class="muted">It moved, or it never existed. The work is still here.</p>
    <div class="btns">
      <a class="btn btn-primary" href="/work">Back to work →</a>
      <a class="btn" href="/">Home</a>
    </div>
  </div>
</Base>

<script>
  const el = document.getElementById('path');
  if (el) el.textContent = location.pathname;
</script>

<style>
  .nf { position: relative; text-align: center; padding-top: 180px; padding-bottom: 40px; }
  .big { font-size: clamp(120px, 24vw, 280px); margin: 12px 0 0; }
  .tag { font-size: clamp(24px, 3vw, 36px); margin: 8px 0 12px; }
  .btns { justify-content: center; margin-top: 32px; }
</style>
