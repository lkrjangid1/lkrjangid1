---
import Base from '../layouts/Base.astro';
import AppIcon from '../components/AppIcon.astro';
import SectionHead from '../components/SectionHead.astro';
import Contributions from '../components/Contributions.astro';
import GithubActivity from '../components/GithubActivity.astro';
import { getGithubStats } from '../data/github';
import { getAllPackages } from '../data/work';
import { isBindgenFamily } from '../data/packages';
import { sortedRepos, statusLabels } from '../data/repos';
import { site } from '../data/site';
import { ids } from '../data/seo';

const packages = await getAllPackages();
const github = await getGithubStats();
const family = packages.filter((p) => isBindgenFamily(p.name));
const standalone = packages.filter((p) => !isBindgenFamily(p.name));
const cli = packages.find((p) => p.name === 'native_api_bindgen');
const listLd = {
  '@type': 'ItemList',
  name: 'pub.dev packages by Lokesh Jangid',
  numberOfItems: packages.length,
  itemListElement: packages.map((p, i) => ({
    '@type': 'ListItem', position: i + 1,
    item: { '@type': 'SoftwareSourceCode', name: p.name, description: p.description, url: p.url, programmingLanguage: 'Dart', codeRepository: p.url, author: { '@id': ids.person } },
  })),
};
---
<Base
  title={`${packages.length} Flutter & Dart Packages on pub.dev`}
  keywords={['Flutter packages', 'Dart packages', 'pub.dev plugins', 'Flutter plugin developer', 'native bindings', 'JNI', 'open source Flutter']}
  current="/open-source"
  ogSlug="open-source"
  pageType="CollectionPage"
  jsonLd={listLd}
  description={`${packages.length} Flutter and Dart packages on pub.dev by Lokesh Jangid, the native-api-bindgen toolchain, GitHub repos and Hacktoberfest contributions.`}
>
  <div class="wrap">
    <header class="page-head">
      <div class="page-glow" aria-hidden="true"></div>
      <SectionHead as="h1" label="Open source · pub.dev/publishers/lkrjangid.tech" title={`${packages.length} packages.`} accent="And the repos behind them." split={false}
        lead="Flutter plugins, developer tools and a whole native-bindings toolchain, published under lkrjangid.tech." />
    </header>

    {family.length > 0 && (
      <a class="ui-card lg glow toolchain" href="/work/native-api-bindgen" data-reveal data-cursor="Read">
        <div class="tc-copy">
          <AppIcon slug="native-api-bindgen" name="native-api-bindgen" size={64} />
          <p class="label">The toolchain · {family.length} packages · {cli?.version}</p>
          <h2 class="h3 mono-title">native_api_*</h2>
          <p class="muted">Typed Dart and TypeScript bindings generated from the Android and Apple SDKs on your machine: CLI, IR, generators and runtimes.</p>
          <span class="go">Read the case study →</span>
        </div>
        <ul class="tc-list">
          {family.map((p) => <li><span class="mono">{p.name}</span><span class="muted">{p.description}</span></li>)}
        </ul>
      </a>
    )}

    <section class="section" aria-labelledby="pkg-h">
      <SectionHead id="pkg-h" size="sub" label={`${standalone.length} packages`} title="Standalone plugins." />
      <div class="ui-grid pkg-grid">
        {standalone.map((p) => (
          <a class="ui-card glow pkg" href={p.url} rel="noopener" data-reveal data-tilt data-cursor="pub.dev">
            <div class="pkg-top"><span class="mono name">{p.name}</span>{p.version && <span class="chip">{p.version}</span>}</div>
            <p class="muted">{p.description}</p>
            <div class="pkg-meta">
              {p.platforms.length > 0 && <span class="label">{p.platforms.join(' · ')}</span>}
              {p.points != null && <span class="label pts">{p.points}/{p.maxPoints} pts</span>}
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="section" aria-labelledby="repo-h">
      <SectionHead id="repo-h" size="sub" label="GitHub" title="Repositories."><a class="btn" href={site.links.github} rel="noopener">github.com/lkrjangid1 ↗</a></SectionHead>
      <ul class="rows">
        {sortedRepos.map((r) => (
          <li>
            <a href={r.caseStudy ? `/work/${r.slug}` : r.repo} rel={r.caseStudy ? undefined : 'noopener'}>
              <span class="repo-name"><AppIcon slug={r.slug} name={r.name} size={36} /><span><b>{r.name}</b><span class="muted">{r.desc}</span></span></span>
              <span class="label repo-st">{statusLabels[r.status]} · {r.year}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    {github && (
      <section id="github" class="section" aria-labelledby="gh-h">
        <SectionHead id="gh-h" size="sub" label="GitHub · activity" title="Building" accent="in public."
          lead="Pulled from GitHub at every build: a year of contributions, followers and public repositories.">
          <a class="btn" href={github.url} rel="noopener" data-cursor="GitHub">@{github.user} ↗</a>
        </SectionHead>
        <GithubActivity stats={github} />
      </section>
    )}

    <section class="section" aria-labelledby="contrib-h">
      <SectionHead id="contrib-h" size="sub" label="Open-source contributions · Hacktoberfest · Holopin" title="Contributor," accent="two Octobers running." lead="Hacktoberfest contributor in 2020 and 2021, with swag to prove it, and badges collected on Holopin.">
        <a class="btn" href={site.links.holopin} rel="noopener" data-cursor="Holopin">Holopin board ↗</a>
      </SectionHead>
      <Contributions />
    </section>

  </div>
</Base>

<style>
  .toolchain { display: grid; grid-template-columns: 1fr 1.1fr; gap: 32px; }
  .tc-copy { display: flex; flex-direction: column; gap: 12px; align-items: flex-start; }
  .mono-title { font-family: var(--font-mono); letter-spacing: -.03em; color: var(--accent); }
  .go { margin-top: auto; color: var(--accent); font-weight: 500; }
  .tc-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; max-height: 360px; overflow: auto; }
  .tc-list li { display: grid; gap: 2px; padding: 10px 14px; border-radius: var(--r-item); }
  .tc-list li:nth-child(odd) { background: var(--surface-2); }
  .tc-list .mono { color: var(--text); }
  .tc-list .muted { font-size: 13.5px; }

  .pkg-grid { grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); }
  .pkg { display: flex; flex-direction: column; gap: 10px; }
  .pkg-top { display: flex; justify-content: space-between; align-items: center; gap: 10px; }
  .name { font-size: 15px; color: var(--text); }
  .pkg .muted { font-size: 15px; line-height: 1.55; }
  .pkg-meta { margin-top: auto; display: flex; justify-content: space-between; gap: 10px; flex-wrap: wrap; }
  .pts { color: var(--mint); }

  .repo-name { display: flex; align-items: center; gap: 14px; min-width: 0; }
  .repo-name > span:last-child { display: flex; flex-direction: column; min-width: 0; }
  .repo-name .muted { font-size: 14px; }
  .repo-st { white-space: nowrap; flex: none; }
  .note { margin-top: 24px; font-size: 15px; }
  @media (max-width: 900px) { .toolchain { grid-template-columns: 1fr; } }
  @media (max-width: 600px) { .rows > li > a { flex-direction: column; gap: 8px; } }
</style>
