---
import Base from "../layouts/Base.astro";
import AppIcon from "../components/AppIcon.astro";
import SectionHead from "../components/SectionHead.astro";
import ProductMarquee from "../components/ProductMarquee.astro";
import Showcase from "../components/Showcase.astro";
import Splash from "../components/Splash.astro";
import "../styles/home.css";
import { shortNames, site } from "../data/site";
import { getWork, getAllPackages } from "../data/work";
import { buildLineup, buildReel } from "../data/home";
import { repos } from "../data/repos";
import { getRecommendations } from "../data/recommendations";
import { getArticleCount } from "../data/stats";

const { projects } = await getWork();
const reelItems = buildReel(projects);
const lineup = buildLineup(projects);
const packages = await getAllPackages();
const articleCount = await getArticleCount();
const recommendations = await getRecommendations();

const dockApps = lineup.filter((t) => t.metric).slice(0, 3);
const dock = [...reelItems.map((r) => ({ slug: r.slug, name: r.name, href: `#p-${r.slug}` })), null,
  ...dockApps.map((t) => ({ slug: t.slug, name: t.name, href: t.href }))];
// The last dock slot is a folder previewing four more apps; it opens /work.
const folderApps = lineup.filter((t) => !dockApps.includes(t)).slice(0, 4);
const moreCount = lineup.length - dockApps.length;

const marqueeItems = [
  ...reelItems.map((r) => ({ slug: r.slug, name: r.name, href: r.href })),
  ...lineup.map((t) => ({ slug: t.slug, name: shortNames[t.slug] ?? t.name, href: t.href })),
];

const years = Math.floor((Date.now() - Date.UTC(2021, 1, 1)) / 31_557_600_000);
// Everything that used to be stacked on the home page now has its own page; these cards point there.
const explore = [
  { href: "/work", n: projects.length + repos.length, label: "Projects", title: "All work", text: "Every app, tool and experiment, filterable, with case studies.", app: "#3db9ff" },
  { href: "/open-source", n: packages.length, label: "pub.dev packages", title: "Open source", text: "Packages, repositories, GitHub activity and Hacktoberfest.", app: "#7cf2d0" },
  { href: "/writing", n: articleCount, label: "Articles", title: "Writing", text: "Flutter internals, Shorebird code push, native interop.", app: "#ff7a45" },
  { href: "/about", n: `${years}+`, label: `Years shipping · ${recommendations.length} recommendations`, title: "About", text: "Experience, skills radar, achievements and kind words.", app: "#b48cff" },
];
---
<Base current="/" rawTitle="Lokesh Jangid · Senior Flutter Developer in India" ogType="profile" pageType="ProfilePage"
  keywords={['Flutter developer', 'Senior Flutter developer', 'Flutter app developer India', 'mobile app developer', 'Android developer', 'iOS developer', 'software developer', 'hire Flutter developer', 'Lokesh Jangid']}
  description="Lokesh Jangid, Senior Flutter developer in India: Flutter, Android and iOS apps for 9M+ users at Univest, 24 pub.dev packages and OTA code push. Hire me.">
  <Splash />

  <!-- ============ HERO ============ -->
  <section class="hero" aria-labelledby="hero-name">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="wrap hero-main">
      <h1 id="hero-name" class="display name"><span class="hero-role">{site.role} · Android &amp; iOS · India</span>{site.name}</h1>
      <p class="lead hero-intro" data-reveal>
        I build Flutter, Android and iOS apps for <strong>9M+ users</strong> at <strong>Univest</strong>,
        <span class="serif accent">and the tooling underneath them.</span>
      </p>
      <div class="hero-ctas" data-reveal>
        <a class="btn btn-primary" href="#work">See what's shipping ↓</a>
        <a class="btn" href="/contact">Work with me ↗</a>
      </div>
    </div>

    <div class="dock-wrap" data-reveal>
      <p class="label">Now shipping · pick one</p>
      <nav class="dock" aria-label="Products">
        {dock.map((d) => d ? (
          <a href={d.href} class="dock-item" data-tip={d.name} aria-label={d.name}><AppIcon slug={d.slug} name={d.name} size={54} /></a>
        ) : <span class="dock-sep" aria-hidden="true"></span>)}
        <a href="/work" class="dock-item" data-tip={`${moreCount} more · all work`} aria-label={`All work: ${moreCount} more projects`} data-cursor="All work">
          <span class="folder" aria-hidden="true">
            {folderApps.map((t) => <AppIcon slug={t.slug} name={t.name} size={20} />)}
          </span>
        </a>
      </nav>
    </div>

  </section>

  <!-- ============ SHOWCASE ============ -->
  <Showcase items={reelItems} />

  <div class="marquee-gap"><ProductMarquee items={marqueeItems} /></div>

  <!-- ============ EXPLORE ============ -->
  <section class="wrap section" aria-labelledby="ex-h">
    <SectionHead id="ex-h" label="Everything else · Flutter, Android, iOS" title="There is more" accent="where that came from."
      lead="The full catalogue, the open-source work, the writing and the story behind it each have their own page." />
    <div class="explore">
      {explore.map((e) => (
        <a class="ui-card lg glow hoverable ex" href={e.href} style={`--app:${e.app}`} data-reveal data-tilt data-cursor="Open">
          <b>{e.n}</b><span class="label">{e.label}</span>
          <h3 class="h3">{e.title}</h3>
          <p class="muted">{e.text}</p>
          <span class="go">Open →</span>
        </a>
      ))}
    </div>
  </section>

  <!-- ============ CONTACT ============ -->
  <section id="contact" class="wrap section contact" aria-labelledby="contact-h">
    <div class="contact-glow" aria-hidden="true"></div>
    <SectionHead id="contact-h" label="Contact · Hire a Flutter developer" title="Have an app to build" accent="or fix?" />
    <div class="ui-grid contact-cards">
      <a class="ui-card lg glow ccard" href="/contact" data-reveal data-tilt data-cursor="Write">
        <p class="label">Full-time</p><h3 class="h3">Hire me</h3>
        <p class="muted">Senior mobile or platform roles. Flutter, native Android and iOS, fintech scale.</p>
        <span class="go">Send a message →</span>
      </a>
      <a class="ui-card lg glow ccard" href={`mailto:${site.email}?subject=Consulting`} data-reveal data-tilt data-cursor="Email">
        <p class="label">Consulting</p><h3 class="h3">Second pair of eyes</h3>
        <p class="muted">Code push setup, startup time, crash rate, native plugins and performance reviews.</p>
        <span class="go">{site.email} →</span>
      </a>
    </div>
  </section>
</Base>
