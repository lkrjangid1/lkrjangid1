---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import AppIcon from '../components/AppIcon.astro';
import Device from '../components/Device.astro';
import Shot from '../components/Shot.astro';
import Icon from '../components/Icon.astro';
import portrait from '../assets/portrait.webp';
import '../styles/home.css';
import { experience, proof, site, wins, writing } from '../data/site';
import { getWork, getAllPackages } from '../data/work';
import { buildLineup, buildReel } from '../data/home';
import { brand } from '../data/icons';
import { isBindgenFamily } from '../data/packages';
import { sortedRepos, statusLabels } from '../data/repos';
import { getRecommendations } from '../data/recommendations';
import { getArticleCount } from '../data/stats';

const { projects } = await getWork();
const reelItems = buildReel(projects);
const lineup = buildLineup(projects);
const packages = await getAllPackages();
const articleCount = await getArticleCount();
const recommendations = await getRecommendations();

const counts: Record<string, number> = { packages: packages.length, articles: articleCount };
const stats = proof.map((s) => ({ ...s, value: 'key' in s ? counts[s.key] ?? s.value : s.value }));

const family = packages.filter((p) => isBindgenFamily(p.name));
const topPackages = packages
  .filter((p) => !isBindgenFamily(p.name))
  .sort((a, b) => (b.points ?? 0) - (a.points ?? 0))
  .slice(0, 7);
const otherPackages = packages.length - family.length - topPackages.length;
const repoStrip = sortedRepos.filter((r) => r.slug !== 'native-api-bindgen').slice(0, 5);

const series = writing.filter((p) => p.series).sort((a, b) => a.title.localeCompare(b.title));
const recent = writing.filter((p) => !p.series).slice(0, 4);
const month = new Intl.DateTimeFormat('en-GB', { month: 'short', year: 'numeric' });

const dock = [...reelItems.map((r) => ({ slug: r.slug, name: r.name, href: `#p-${r.slug}` })), null,
  ...lineup.filter((t) => t.metric).slice(0, 4).map((t) => ({ slug: t.slug, name: t.name, href: t.href }))];

const terminal = [
  '<span class="p">$</span> dart pub global activate native_api_bindgen',
  '<span class="p">$</span> native-api-bindgen doctor',
  '<span class="ok">✓</span> Android SDK · JDK · Xcode · libclang',
  '<span class="p">$</span> native-api-bindgen generate flutter',
  '<span class="dim">  parsing android.jar → IR …</span>',
  '<span class="ok">✓ 51,429 of 52,938 methods generated (97.1%)</span>',
  '<span class="dim">  1,509 skipped, each with a reason code</span>',
  '<span class="p">$</span> <span class="caret"></span>',
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: site.url,
  image: new URL('/og/home.png', site.url).href,
  jobTitle: site.role,
  email: `mailto:${site.email}`,
  address: { '@type': 'PostalAddress', addressLocality: 'Gurgaon', addressCountry: 'IN' },
  worksFor: { '@type': 'Organization', name: 'Univest' },
  alumniOf: [{ '@type': 'CollegeOrUniversity', name: 'MBM University' }],
  description: site.description,
  knowsAbout: ['Flutter', 'Dart', 'Kotlin', 'Swift', 'Android', 'iOS', 'JNI', 'Code push'],
  sameAs: Object.values(site.links),
};
---
<Base current="/" jsonLd={jsonLd}>
  <!-- ============ HERO ============ -->
  <section class="hero" aria-labelledby="hero-name">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="wrap hero-top">
      <a class="status" href="/contact" data-reveal>
        <span class="dot pulse"></span>
        <span><strong>{site.status}</strong><small>{site.statusSub}</small></span>
        <span class="status-go" aria-hidden="true">→</span>
      </a>
      <p class="where" data-reveal>Based in {site.location}<br /><span class="muted">Local time <time data-clock={site.timezone}>—</time> IST</span></p>
    </div>

    <div class="hero-stage">
      <Image class="portrait" src={portrait} alt={`Portrait of ${site.name}`} width={900} loading="eager" fetchpriority="high" format="webp" quality={84} />
      <h1 id="hero-name" class="display name" data-split-chars>{site.name}</h1>
    </div>

    <div class="wrap hero-bottom">
      <p class="lead hero-intro" data-reveal>
        {site.role} at <strong>Univest</strong>. I build Flutter, Android and iOS apps for
        <strong>9M+ users</strong>, <span class="serif accent">and the tooling underneath them.</span>
      </p>
      <div class="hero-side" data-reveal>
        <div class="currently" data-rotator aria-live="polite">
          <div class="currently-head"><span class="label">Currently</span><span class="ticks" aria-hidden="true">{site.currently.map((_, i) => <i class={i === 0 ? 'on' : ''}></i>)}</span></div>
          <ul class="currently-list">
            {site.currently.map((c, i) => <li class={i === 0 ? 'on' : ''}>{c.label} <span class="muted">{c.at}</span></li>)}
          </ul>
        </div>
        <div class="hero-ctas">
          <a class="btn btn-primary" href="#work">See what's shipping ↓</a>
          <a class="btn" href="/contact">Work with me ↗</a>
        </div>
      </div>
    </div>

    <div class="dock-wrap" data-reveal>
      <p class="label dock-label">Now shipping · pick one</p>
      <nav class="dock" aria-label="Products">
        {dock.map((d) => d ? (
          <a href={d.href} class="dock-item" data-tip={d.name} aria-label={d.name}><AppIcon slug={d.slug} name={d.name} size={54} /></a>
        ) : <span class="dock-sep" aria-hidden="true"></span>)}
      </nav>
    </div>

    <div class="wrap proof" aria-label="Impact in numbers">
      {stats.map((s) => (
        <a class="stat" href={s.href} rel="noopener" data-reveal>
          <b data-count={s.value} data-suffix={s.suffix}>{s.value}{s.suffix}</b><span class="label">{s.label}</span>
        </a>
      ))}
    </div>
  </section>

  <div class="marquee" aria-label="Highlights">
    {[0, 1].map((copy) => (
      <div class="marquee-track" aria-hidden={copy === 1 ? 'true' : undefined}>
        {wins.map(([a, b]) => <span><b>{a}</b> {b}</span>)}
      </div>
    ))}
  </div>

  <!-- ============ REEL ============ -->
  <section id="work" class="reel-intro wrap" aria-labelledby="work-h">
    <div>
      <p class="label">Featured · production and products</p>
      <h2 id="work-h" class="h2" data-split>Now shipping.</h2>
      <p class="serif reel-tag accent" data-reveal>From order books to OTA patches.</p>
    </div>
    <p class="lead reel-note" data-reveal>Fintech at scale by day, developer tooling the rest of the time. Scroll to step inside each one; everything else is in <a class="link" href="#lineup">the lineup</a>.</p>
  </section>

  <div class="reel">
    <aside class="rail" aria-label="Featured products">
      <span class="label rail-count" data-rail-n>01 / {String(reelItems.length).padStart(2, '0')}</span>
      {reelItems.map((r) => <a href={`#p-${r.slug}`} class="rail-link" aria-label={r.name}><AppIcon slug={r.slug} name={r.name} size={36} class="rail-icon" /></a>)}
    </aside>

    {reelItems.map((r, i) => (
      <article id={`p-${r.slug}`} class:list={['product', 'wrap', { flip: i % 2 === 1 }]} style={`--app:${brand(r.slug, r.name).accent}`} data-index={i}>
        <div class="product-copy" data-reveal>
          <div class="product-head">
            <AppIcon slug={r.slug} name={r.name} size={64} />
            <div><span class="label">{String(i + 1).padStart(2, '0')} / {String(reelItems.length).padStart(2, '0')}</span><span class="pill">{r.platform}</span></div>
          </div>
          <h3 class="display product-name">{r.name}</h3>
          <p class="serif product-tag">{r.tagline}</p>
          <ul class="product-points">{r.points.map((pt) => <li>{pt}</li>)}</ul>
          {r.metrics.length > 0 && <ul class="metrics">{r.metrics.map((m) => <li>{m}</li>)}</ul>}
          {r.visual === 'terminal' && (
            <div class="bench" role="img" aria-label="1 MB round trip: bindgen 1.80 ms, MethodChannel 9.02 ms">
              <div class="bench-row"><span class="mono">bindgen</span><span class="bar"><i style="--w:20%" class="hi"></i></span><span class="mono">1.80 ms</span></div>
              <div class="bench-row"><span class="mono">MethodChannel</span><span class="bar"><i style="--w:100%"></i></span><span class="mono">9.02 ms</span></div>
              <p class="label">1 MB round trip · Oct 2026</p>
            </div>
          )}
          <div class="store">
            <a class="btn btn-sm btn-primary" href={r.href}>Case study →</a>
            {r.links.slice(0, 3).map((l) => <a class="btn btn-sm" href={l.url} rel="noopener">{l.label} ↗</a>)}
          </div>
        </div>
        <div class="product-visual" data-reveal>
          {r.visual === 'phones' && (
            <div class="two-phones">
              {r.shots.slice(0, 2).map((s, j) => <Device kind="phone" shots={[s]} alt={`${r.name} screen ${j + 1}`} class={j === 0 ? 'tilt-l' : 'tilt-r'} />)}
            </div>
          )}
          {r.visual === 'phone' && <Device kind="phone" size="big" shots={r.shots.slice(0, 6)} alt={`${r.name} screens`} />}
          {r.visual === 'laptop' && <Device kind="laptop" shots={r.shots.slice(0, 3)} alt={`${r.name} screens`} />}
          {r.visual === 'browser' && <Device kind="browser" shots={r.shots.slice(0, 4)} alt={`${r.name} screens`} url={`${r.slug}.app`} />}
          {r.visual === 'terminal' && (
            <div class="terminal">
              <div class="bar"><i></i><i></i><i></i><span class="mono dim" style="margin-left:8px">~/app — zsh</span></div>
              <pre aria-label="native-api-bindgen terminal session" set:html={terminal.map((l) => `<span class="tl">${l}</span>`).join('\n')} />
            </div>
          )}
        </div>
      </article>
    ))}
  </div>

  <!-- ============ LINEUP ============ -->
  <section id="lineup" class="wrap section" aria-labelledby="lineup-h">
    <div class="section-head">
      <div><p class="label">The lineup</p><h2 id="lineup-h" class="h2" data-split>Everything else<br />I've shipped.</h2></div>
      <p class="lead" data-reveal>Indie apps with real users, a hackathon win, AI experiments and client work.</p>
    </div>
    <div class="bento">
      {lineup.map((t) => (
        <a href={t.href} class:list={['tile', { 't-wide': t.layout !== 'text', 't-image': t.layout === 'image' }]} style={`--app:${brand(t.slug, t.name).accent}`} data-reveal data-tilt>
          <div class="tile-copy">
            <AppIcon slug={t.slug} name={t.name} size={44} />
            <h3 class="h3">{t.name}</h3>
            <p class="muted">{t.summary}</p>
            {t.metric && <p class="tile-metric">{t.metric}</p>}
          </div>
          {t.layout === 'phones' && (
            <div class="tile-shots">
              {t.shots.slice(0, 2).map((s, j) => <Device kind="phone" size="mini" shots={[s]} alt={`${t.name} screen ${j + 1}`} />)}
            </div>
          )}
          {t.layout === 'posters' && (
            <div class="tile-shots posters">
              {t.shots.slice(0, 2).map((s, j) => <Shot src={s} alt={`${t.name} screen ${j + 1}`} width={300} class="poster" />)}
            </div>
          )}
          {t.layout === 'image' && <Shot src={t.shots[0]} alt={`${t.name} screenshot`} width={720} class="tile-img" />}
        </a>
      ))}
    </div>
    <p class="more" data-reveal><a class="btn" href="/work">Browse all work →</a></p>
  </section>

  <!-- ============ OPEN SOURCE ============ -->
  <section id="open-source" class="wrap section" aria-labelledby="os-h">
    <div class="section-head">
      <div><p class="label">Open source · pub.dev/publishers/lkrjangid.tech</p><h2 id="os-h" class="h2" data-split>{packages.length} packages.<br /><span class="serif accent">Used in other people's apps.</span></h2></div>
      <a class="btn" href="/open-source" data-reveal>All open source →</a>
    </div>
    <div class="os-grid">
      <a class="family card" href="/work/native-api-bindgen" data-reveal>
        <p class="label">The toolchain · {family.length} packages</p>
        <h3 class="h3 mono-title">native_api_*</h3>
        <p class="muted">CLI, IR, generators and runtimes behind native-api-bindgen.</p>
        <div class="family-chips">{family.map((p) => <span class="chip">{p.name.replace('native_api_', '')}</span>)}</div>
      </a>
      <ul class="pkgs" data-reveal>
        {topPackages.map((p) => (
          <li><a href={p.url} rel="noopener"><span class="mono">{p.name}</span><span class="muted">{p.description}</span><span class="chip">{p.version || '↗'}</span></a></li>
        ))}
        {otherPackages > 0 && <li><a href={site.links.pubdev} rel="noopener"><span class="mono">+ {otherPackages} more</span><span class="muted">on pub.dev</span><span class="chip">All ↗</span></a></li>}
      </ul>
    </div>
    <div class="repos" data-reveal>
      <p class="label">Repos and experiments</p>
      <div class="repo-row">
        {repoStrip.map((r) => (
          <a class="repo" href={r.repo} rel="noopener"><b>{r.name}</b><span>{r.tech.slice(0, 2).join(' · ')}</span><em class:list={['st', { show: r.status === 'showcase' || r.status === 'production', prog: r.status === 'in-progress' }]}>{statusLabels[r.status]}</em></a>
        ))}
        <a class="repo" href="/open-source"><b>+ {sortedRepos.length - repoStrip.length - 1} more</b><span>Every repo, with its status</span><em class="st">All →</em></a>
      </div>
    </div>
  </section>

  <!-- ============ WRITING ============ -->
  <section id="writing" class="wrap section" aria-labelledby="writing-h">
    <div class="section-head">
      <div><p class="label">Writing · FlutDev</p><h2 id="writing-h" class="h2" data-split>{articleCount} articles.<br /><span class="serif accent">One rabbit hole at a time.</span></h2></div>
      <a class="btn" href="/writing" data-reveal>All writing →</a>
    </div>
    <div class="writing">
      <div class="series" data-reveal>
        <p class="label">Series · May 2026</p>
        <h3 class="h3">Shorebird internals</h3>
        <p class="muted">How Flutter code push really works, from bidiff to a running .so.</p>
        <ol class="stack">
          {series.map((p, i) => (
            <li><a href={p.url} rel="noopener"><span class="mono">{String(i + 1).padStart(2, '0')}</span>{p.title.replace(/^Part \d+:\s*/, '')}</a></li>
          ))}
        </ol>
      </div>
      <ul class="posts" data-reveal>
        {recent.map((p) => <li><a href={p.url} rel="noopener"><span>{p.title}</span><time class="label" datetime={p.date}>{month.format(new Date(p.date))}</time></a></li>)}
      </ul>
    </div>
  </section>

  <!-- ============ TESTIMONIALS ============ -->
  {recommendations.length > 0 && (
    <section id="kind-words" class="wrap section" aria-labelledby="kw-h">
      <div class="section-head">
        <div><p class="label">Recommendations · LinkedIn</p><h2 id="kw-h" class="h2" data-split>People I've<br /><span class="serif accent">shipped with.</span></h2></div>
      </div>
      <div class="quotes">
        {recommendations.map((r) => (
          <figure class="quote" data-reveal>
            <blockquote>{r.recommendation}</blockquote>
            <figcaption>
              <span class="avatar" aria-hidden="true">{r.title.split(' ').map((w) => w[0]).join('').slice(0, 2)}</span>
              <span><a href={r.profile} rel="noopener">{r.title}</a><small>{r.subtitle}</small></span>
            </figcaption>
          </figure>
        ))}
      </div>
    </section>
  )}

  <!-- ============ EXPERIENCE ============ -->
  <section id="about" class="wrap section about" aria-labelledby="about-h">
    <div class="about-copy">
      <p class="label">Experience</p>
      <h2 id="about-h" class="h2" data-split>I like the layer<br /><span class="serif accent">under the app.</span></h2>
      <p class="lead" data-reveal>{site.bio[1]}</p>
      <div class="btns about-ctas" data-reveal>
        <a class="btn" href="/about">More about me →</a>
        <a class="btn" href={site.resume} download>Résumé (PDF) <Icon name="download" size={14} /></a>
      </div>
    </div>
    <ol class="timeline" data-reveal>
      {experience.map((e) => (
        <li><span class="when label">{e.period}</span><b>{e.role}, {e.company.replace(/ Pvt\. Ltd\.| Communication/g, '')}</b><span class="muted">{e.summary}</span></li>
      ))}
      <li><span class="when label">Open source</span><b>Platform tooling</b><span class="muted">native-api-bindgen, PushPatch, {packages.length} pub.dev packages</span></li>
      <li><span class="when label">2019 – 2023</span><b>B.E. Electrical, MBM University</b><span class="muted">Raksha won SSIP funding at IIIT Surat; Hacktoberfest 2020 and 2021</span></li>
    </ol>
  </section>

  <!-- ============ CONTACT ============ -->
  <section id="contact" class="wrap section contact" aria-labelledby="contact-h">
    <div class="contact-glow" aria-hidden="true"></div>
    <p class="label">Contact</p>
    <h2 id="contact-h" class="h2" data-split>Have an app to build<br /><span class="serif accent">or fix?</span></h2>
    <div class="contact-cards">
      <a class="ccard" href="/contact" data-reveal data-tilt>
        <p class="label">Full-time</p><h3 class="h3">Hire me</h3>
        <p class="muted">Senior mobile or platform roles. Flutter, native Android and iOS, fintech scale.</p>
        <span class="ccard-go">Send a message →</span>
      </a>
      <a class="ccard" href={`mailto:${site.email}?subject=Consulting`} data-reveal data-tilt>
        <p class="label">Consulting</p><h3 class="h3">Second pair of eyes</h3>
        <p class="muted">Code push setup, startup time, crash rate, native plugins and performance reviews.</p>
        <span class="ccard-go">{site.email} →</span>
      </a>
    </div>
  </section>
</Base>
