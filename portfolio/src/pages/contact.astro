---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import SectionHead from '../components/SectionHead.astro';
import { services, site } from '../data/site';
import { ids } from '../data/seo';

const serviceLd = {
  '@type': 'Service',
  '@id': `${site.url}/contact#service`,
  name: 'Flutter app development and consulting',
  serviceType: 'Flutter app development',
  description: 'Flutter, native Android and iOS development, app performance work, OTA code push and Flutter plugin development, by Senior Flutter developer Lokesh Jangid.',
  provider: { '@id': ids.person },
  areaServed: 'Worldwide',
  availableChannel: { '@type': 'ServiceChannel', serviceUrl: `${site.url}/contact` },
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Services',
    itemListElement: services.map((s) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: s.title, description: s.detail } })),
  },
};

const engagements = [
  { title: 'Full-time', body: 'Senior Flutter or mobile platform roles, remote or in Delhi NCR.' },
  { title: 'Contract / freelance', body: 'A feature, an app or a migration, scoped up front with clear milestones.' },
  { title: 'Code review and audit', body: 'A written review of architecture, performance and release setup, with a prioritised fix list.' },
];
const steps = ['Short call about the app and the goal', 'Written scope, estimate and milestones', 'Build in small reviewed releases', 'Handover with docs and a walkthrough'];
const faq = [
  { q: 'Do you work remotely?', a: `Yes. I'm based in ${site.location} and work remotely with teams anywhere; for full-time roles I can also work from Delhi NCR.` },
  { q: 'Which time zone do you work in?', a: 'India Standard Time (UTC+5:30). That overlaps the European working day and US mornings or evenings for calls.' },
  { q: 'Flutter or native?', a: 'Flutter for most apps that need Android and iOS from one codebase. Native Kotlin or SwiftUI where the platform matters: widgets, background work, deep OS integration. I do both, and the bridge between them.' },
  { q: 'How do we start, and what does it cost?', a: 'Send a short brief through the form below. I reply within 2 days with questions, then a written scope and estimate before any work starts.' },
];
---
<Base title="Hire a Senior Flutter Developer" current="/contact" ogSlug="contact" pageType="ContactPage" jsonLd={serviceLd}
  keywords={['hire Flutter developer', 'freelance Flutter developer', 'Flutter consultant', 'Flutter app development services', 'hire Android developer', 'hire iOS developer', 'remote Flutter developer India']}
  description="Hire Lokesh Jangid, a Senior Flutter developer: Flutter, Android and iOS apps, code push, performance and plugins. Full-time, freelance or audit. Replies in 2 days.">
  <div class="wrap">
    <header class="page-head">
      <div class="page-glow" aria-hidden="true"></div>
      <SectionHead as="h1" label="Hire a Flutter developer" title="Have an app to build" accent="or fix?" lead={`Senior Flutter developer for Android and iOS apps. ${site.availability}.`} split={false} />
    </header>

    <section class="hire" aria-labelledby="svc-h">
      <h2 id="svc-h" class="label">What I can build for you</h2>
      <ul class="svc">
        {services.map((s) => <li class="ui-card"><h3 class="h4">{s.title}</h3><p class="muted">{s.detail}</p></li>)}
      </ul>
    </section>

    <section class="hire two" aria-label="How we can work together">
      <div>
        <h2 class="label">Ways to work together</h2>
        <ul class="eng">
          {engagements.map((e) => <li><b>{e.title}</b><span class="muted">{e.body}</span></li>)}
        </ul>
      </div>
      <div>
        <h2 class="label">How a project runs</h2>
        <ol class="steps">{steps.map((s) => <li>{s}</li>)}</ol>
      </div>
    </section>

    <h2 class="label form-h" id="form-h">Send a message</h2>

    <div class="contact-grid">
    <form id="contact" class="ui-card lg form" aria-labelledby="form-h" data-email={site.email} action="/api/contact" method="post" novalidate>
      <div class="field">
        <label for="name">Name</label>
        <input id="name" name="name" autocomplete="name" required maxlength="100" aria-describedby="name-err" />
        <p class="err" id="name-err"></p>
      </div>
      <div class="field">
        <label for="email">Email</label>
        <input id="email" name="email" type="email" autocomplete="email" required maxlength="200" placeholder="you@company.com" aria-describedby="email-err" />
        <p class="err" id="email-err"></p>
      </div>
      <div class="field">
        <label for="message">Message</label>
        <textarea id="message" name="message" rows="6" required minlength="10" maxlength="5000" placeholder="We need a Flutter plugin for…" aria-describedby="message-err"></textarea>
        <p class="err" id="message-err"></p>
      </div>
      <div class="hp" aria-hidden="true">
        <label for="company">Company website</label>
        <input id="company" name="company" tabindex="-1" autocomplete="off" />
      </div>
      <input type="hidden" name="t" id="t" />

      <div class="actions">
        <button type="submit" class="btn btn-primary" id="send">Send message</button>
        <p class="status" id="status" role="status" aria-live="polite"></p>
      </div>
    </form>

    <aside class="side" aria-labelledby="else-h">
      <div class="ui-card side-card">
        <p class="label">Email</p>
        <a class="mail" href={`mailto:${site.email}`}>{site.email}</a>
      </div>
      <div class="ui-card side-card">
        <p class="label">Good fits</p>
        <ul>
          <li>Senior mobile or platform roles</li>
          <li>Flutter code push setup and reviews</li>
          <li>Startup time, crash rate and app size work</li>
          <li>Native plugins: Kotlin, Swift, JNI</li>
        </ul>
      </div>
      <div class="ui-card side-card">
        <h2 id="else-h" class="label">Elsewhere</h2>
        <div class="btns">
          <a class="btn btn-sm" href={site.links.linkedin} rel="noopener"><Icon name="linkedin" /> LinkedIn</a>
          <a class="btn btn-sm" href={site.links.github} rel="noopener"><Icon name="github" /> GitHub</a>
          <a class="btn btn-sm" href={site.links.x} rel="noopener"><Icon name="brand-x" /> X</a>
          <a class="btn btn-sm" href={site.resume} download><Icon name="download" /> Résumé</a>
        </div>
      </div>
    </aside>
    </div>

    <section class="hire" aria-labelledby="faq-h">
      <h2 id="faq-h" class="label">Questions clients ask</h2>
      <div class="faq">
        {faq.map((f) => <details class="ui-card"><summary>{f.q}</summary><p class="muted">{f.a}</p></details>)}
      </div>
    </section>
  </div>
</Base>

<script>
  const form = document.getElementById('contact') as HTMLFormElement;
  const status = document.getElementById('status')!;
  const send = document.getElementById('send') as HTMLButtonElement;
  (document.getElementById('t') as HTMLInputElement).value = String(Date.now());

  const fields = {
    name: { el: form.elements.namedItem('name') as HTMLInputElement, check: (v: string) => (v ? '' : 'Enter your name.') },
    email: {
      el: form.elements.namedItem('email') as HTMLInputElement,
      check: (v: string) => (/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(v) ? '' : 'Enter a valid email address.'),
    },
    message: {
      el: form.elements.namedItem('message') as HTMLTextAreaElement,
      check: (v: string) => (v.length >= 10 ? '' : 'Write at least a sentence (10+ characters).'),
    },
  };

  function setError(key: keyof typeof fields, msg: string) {
    const f = fields[key];
    document.getElementById(`${key}-err`)!.textContent = msg;
    f.el.setAttribute('aria-invalid', String(Boolean(msg)));
  }

  function setStatus(msg: string, kind: '' | 'ok' | 'error') {
    status.textContent = msg;
    status.dataset.kind = kind;
  }

  for (const key of Object.keys(fields) as (keyof typeof fields)[]) {
    fields[key].el.addEventListener('blur', () => setError(key, fields[key].check(fields[key].el.value.trim())));
    fields[key].el.addEventListener('input', () => {
      if (fields[key].el.getAttribute('aria-invalid') === 'true') setError(key, fields[key].check(fields[key].el.value.trim()));
      if (status.dataset.kind === 'error') setStatus('', '');
    });
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    let firstBad: HTMLElement | undefined;
    for (const key of Object.keys(fields) as (keyof typeof fields)[]) {
      const msg = fields[key].check(fields[key].el.value.trim());
      setError(key, msg);
      if (msg && !firstBad) firstBad = fields[key].el;
    }
    if (firstBad) return firstBad.focus();

    if (!navigator.onLine) return setStatus("You're offline. Check your connection and try again.", 'error');

    send.disabled = true;
    setStatus('Sending…', '');
    try {
      const res = await fetch(form.action, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(Object.fromEntries(new FormData(form))),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(data.error || `HTTP ${res.status}`);
      form.reset();
      setStatus("Thanks — message sent. I'll reply within 2 days.", 'ok');
    } catch {
      if (!navigator.onLine) {
        setStatus("You're offline. Check your connection and try again.", 'error');
      } else {
        // Server unavailable: hand the message to the visitor's mail app so nothing they typed is lost.
        const v = (n: string) => (form.elements.namedItem(n) as HTMLInputElement).value.trim();
        const mail = `mailto:${form.dataset.email}?subject=${encodeURIComponent(`Portfolio: message from ${v('name')}`)}&body=${encodeURIComponent(`${v('message')}\n\n— ${v('name')} <${v('email')}>`)}`;
        setStatus("The form couldn't send just now. ", 'error');
        const a = document.createElement('a');
        a.href = mail;
        a.textContent = 'Send it by email instead →';
        a.className = 'link';
        status.append(a);
      }
    } finally {
      send.disabled = false;
    }
  });
</script>

<style>
  .hire { margin-bottom: clamp(40px, 6vw, 72px); }
  .hire .label, .form-h { margin: 0 0 16px; }
  .contact-grid + .hire { margin-top: clamp(48px, 6vw, 80px); }
  .svc { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(300px, 100%), 1fr)); gap: var(--gap-grid); }
  .svc h3 { margin: 0 0 8px; }
  .svc p { margin: 0; font-size: 15px; }
  .two { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr)); gap: clamp(24px, 5vw, 64px); }
  .eng { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; }
  .eng li { display: grid; gap: 2px; }
  .steps { margin: 0; padding-left: 22px; display: grid; gap: 10px; color: var(--text-2); }
  .faq { display: grid; gap: 12px; }
  .faq summary { cursor: pointer; font-weight: 500; }
  .faq p { margin: 10px 0 0; }
  .contact-grid { display: grid; grid-template-columns: 1.4fr 1fr; gap: var(--gap-grid); align-items: start; }
  .form { display: grid; gap: 6px; }
  .side { display: grid; gap: var(--gap-grid); }
  .side-card .label { margin-bottom: 12px; }
  .mail { font: 600 clamp(18px, 2vw, 22px)/1.3 var(--font-display); color: var(--accent); word-break: break-all; }
  .side-card ul { margin: 0; padding-left: 18px; color: var(--text-2); }
  .side-card li + li { margin-top: 6px; }
  @media (max-width: 900px) { .contact-grid { grid-template-columns: 1fr; } }
  .field { display: grid; gap: 6px; }
  label { font-size: 14px; color: var(--text-secondary); }
  input, textarea {
    width: 100%; background: var(--surface-2); border: 1px solid var(--border-strong);
    border-radius: var(--radius); padding: 10px 12px; font-size: 16px; line-height: 1.5;
  }
  textarea { resize: vertical; min-height: 140px; }
  input:focus-visible, textarea:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }
  [aria-invalid='true'] { border-color: var(--danger); }
  .err { min-height: 20px; font-size: 13px; color: var(--danger); }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .actions { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; margin-top: 4px; }
  .status { font-size: 14px; color: var(--text-secondary); }
  .status[data-kind='ok'] { color: var(--success); }
  .status[data-kind='error'] { color: var(--danger); }
  button:disabled { opacity: .6; cursor: progress; }
</style>
