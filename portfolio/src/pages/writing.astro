---
import Base from '../layouts/Base.astro';
import { site, writing } from '../data/site';
import { getArticleCount } from '../data/stats';
import SectionHead from '../components/SectionHead.astro';

const total = await getArticleCount();
const series = writing.filter((p) => p.series).sort((a, b) => a.title.localeCompare(b.title));
const posts = writing.filter((p) => !p.series).sort((a, b) => b.date.localeCompare(a.date));
const fmt = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
---
<Base title="Writing" current="/writing" ogSlug="writing" description="Selected posts from FlutDev on Flutter internals, Shorebird code push, native interop and app performance.">
  <div class="wrap">
    <header class="page-head">
      <div class="page-glow" aria-hidden="true"></div>
      <SectionHead as="h1" label="Writing · FlutDev" title={`${total} articles.`} accent="One rabbit hole at a time." split={false}
        lead="Selected posts on Flutter internals, native interop and performance. Every link opens the original on FlutDev." />
    </header>

    <section class="ui-card lg glow series" style="--app:#ff7a45" aria-labelledby="series-h" data-reveal>
      <div>
        <p class="label">Series · May 2026 · 4 parts</p>
        <h2 id="series-h" class="h3">Shorebird internals</h2>
        <p class="muted">How Flutter code push really works, from bidiff and zstd to a running .so. The research behind the self-hosted code push at Univest and PushPatch.</p>
      </div>
      <ol class="stack">
        {series.map((p, i) => (
          <li><a class="ui-item" href={p.url} rel="noopener" data-cursor="Read"><span class="mono">{String(i + 1).padStart(2, '0')}</span><span>{p.title.replace(/^Part \d+:\s*/, '')}</span><span aria-hidden="true">↗</span></a></li>
        ))}
      </ol>
    </section>

    <section class="section" aria-labelledby="posts-h">
      <SectionHead id="posts-h" size="sub" label={`${posts.length} selected`} title="More posts." />
      <ul class="rows posts">
        {posts.map((p) => (
          <li><a href={p.url} rel="noopener" data-cursor="Read"><span>{p.title}</span><time class="label" datetime={p.date}>{fmt.format(new Date(p.date))}</time></a></li>
        ))}
      </ul>
      <p class="more"><a class="btn" href={site.links.blog} rel="noopener">All {total} posts on FlutDev ↗</a></p>
    </section>
  </div>
</Base>

<style>
  .series { display: grid; grid-template-columns: 1fr 1.2fr; gap: 40px; }
  .series .h3 { margin: 12px 0 10px; }
  .stack { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .stack a { display: grid; grid-template-columns: auto 1fr auto; gap: 14px; align-items: center; }
  .stack a:hover { transform: translateX(6px); }
  .stack .mono { color: var(--app); }
  .posts a { font: 500 clamp(18px, 1.8vw, 23px)/1.35 var(--font-display); letter-spacing: -.01em; }
  .posts time { white-space: nowrap; flex: none; }
  .more { margin-top: 40px; }
  @media (max-width: 900px) { .series { grid-template-columns: 1fr; } }
  @media (max-width: 560px) { .posts a { flex-direction: column; gap: 6px; } }
</style>
