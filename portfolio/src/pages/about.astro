---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import SectionHead from '../components/SectionHead.astro';
import Quote from '../components/Quote.astro';
import Timeline from '../components/Timeline.astro';
import SkillsRadar from '../components/SkillsRadar.astro';
import portrait from '../assets/portrait.webp';
import { achievements, experience, services, site } from '../data/site';
import { getRecommendations } from '../data/recommendations';

const recommendations = await getRecommendations();
---
<Base rawTitle="About Lokesh Jangid · Flutter, Android & iOS Developer" current="/about" ogSlug="about" ogType="profile" pageType="ProfilePage"
  keywords={['Flutter developer Gurgaon', 'Flutter developer Gurugram', 'Android developer', 'iOS developer', 'software engineer résumé', 'remote Flutter developer']}
  description="Lokesh Jangid is a Senior Flutter developer in Gurugram, India with 4+ years shipping Flutter, Android and iOS apps. Experience, skills, résumé and references.">
  <div class="wrap">
    <header class="page-head about-head">
      <div class="page-glow" aria-hidden="true"></div>
      <div>
        <SectionHead as="h1" label="About" title="Hi, I'm Lokesh." accent="I ship mobile apps." split={false} />
        <div class="prose lead">{site.bio.map((p) => <p>{p}</p>)}</div>
        <div class="btns ctas">
          <a class="btn btn-primary" href={site.resume} download data-cursor="PDF">Download résumé <Icon name="download" size={14} /></a>
          <a class="btn" href="/contact">Get in touch</a>
          <a class="btn" href={site.links.linkedin} rel="noopener">LinkedIn ↗</a>
        </div>
      </div>
      <figure class="photo">
        <Image src={portrait} alt={`${site.name}, Flutter developer in Gurugram, India`} width={640} format="webp" quality={84} loading="eager" />
        <figcaption class="label">{site.location} · <time data-clock={site.timezone}>—</time> IST</figcaption>
      </figure>
    </header>

    <section class="section" aria-labelledby="xp-h">
      <SectionHead id="xp-h" size="sub" label={`Experience · ${experience.length} roles · since Feb 2021`} title="Where I've built." />
      <Timeline />
    </section>

    <section class="section" aria-labelledby="do-h">
      <SectionHead id="do-h" size="sub" label="What I do · remote from India" title="Flutter, Android and iOS," accent="end to end." split={false} />
      <ul class="do" data-reveal>
        {services.map((s) => <li class="ui-card"><h3 class="h4">{s.title}</h3><p class="muted">{s.short}</p></li>)}
      </ul>
      <p class="muted do-more">Hiring, or need a hand on one of these? <a class="link" href="/contact">See how I work and get in touch →</a></p>
    </section>

    <section class="section" aria-labelledby="ach-h">
      <SectionHead id="ach-h" size="sub" label="Achievements" title="Recognised." split={false} />
      <ul class="rows" data-reveal>
        {achievements.map((a) => <li><div><span>{a}</span></div></li>)}
      </ul>
    </section>

    <section class="section" aria-labelledby="sk-h">
      <SectionHead id="sk-h" size="sub" label="Skills" title="The stack behind the products." />
      <SkillsRadar />
    </section>

    {recommendations.length > 0 && (
      <section class="section" aria-labelledby="rec-h">
        <SectionHead id="rec-h" size="sub" label="Recommendations · LinkedIn" title="In their words." />
        <div class="quotes">{recommendations.map((r) => <Quote r={r} />)}</div>
      </section>
    )}
  </div>
</Base>

<style>
  .about-head { display: grid; grid-template-columns: 1.3fr .9fr; gap: clamp(32px, 6vw, 96px); align-items: end; }
  .about-head :global(.shead) { margin-bottom: 24px; }
  .ctas { margin-top: 32px; }
  .photo { margin: 0; justify-self: center; text-align: center; }
  .photo :global(img) {
    width: min(380px, 80vw); height: auto;
    background: radial-gradient(70% 60% at 50% 45%, var(--accent-soft), transparent 70%);
    -webkit-mask-image: linear-gradient(#000 78%, transparent); mask-image: linear-gradient(#000 78%, transparent);
  }
  .photo .label { margin-top: 6px; }




  .quotes { columns: 2 340px; column-gap: var(--gap-grid); }
  .do { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(260px, 100%), 1fr)); gap: var(--gap-grid); }
  .do h3 { margin: 0 0 6px; }
  .do p { margin: 0; }
  .do-more { margin-top: 20px; }

  @media (max-width: 900px) {
    .about-head, .split { grid-template-columns: 1fr; }
    .photo { order: -1; }
  }
</style>
