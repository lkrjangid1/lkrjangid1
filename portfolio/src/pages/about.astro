---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import SectionHead from '../components/SectionHead.astro';
import Quote from '../components/Quote.astro';
import portrait from '../assets/portrait.webp';
import { achievements, education, experience, site, skills } from '../data/site';
import { getRecommendations } from '../data/recommendations';

const recommendations = await getRecommendations();
---
<Base title="About" current="/about" ogSlug="about" description={site.bio.join(' ')}>
  <div class="wrap">
    <header class="page-head about-head">
      <div class="page-glow" aria-hidden="true"></div>
      <div>
        <SectionHead as="h1" label="About" title="Hi, I'm Lokesh." accent="I ship mobile apps." split={false} />
        <div class="prose lead">{site.bio.map((p) => <p>{p}</p>)}</div>
        <div class="btns ctas">
          <a class="btn btn-primary" href={site.resume} download data-cursor="PDF">Download résumé <Icon name="download" size={14} /></a>
          <a class="btn" href="/contact">Get in touch</a>
          <a class="btn" href={site.links.linkedin} rel="noopener">LinkedIn ↗</a>
        </div>
      </div>
      <figure class="photo">
        <Image src={portrait} alt={`Portrait of ${site.name}`} width={640} format="webp" quality={84} loading="eager" />
        <figcaption class="label">{site.location} · <time data-clock={site.timezone}>—</time> IST</figcaption>
      </figure>
    </header>

    <section class="section" aria-labelledby="xp-h">
      <SectionHead id="xp-h" size="sub" label="Experience" title="Where I've worked." />
      <ol class="ui-grid jobs">
        {experience.map((e) => (
          <li class="ui-card lg job" data-reveal>
            <div class="job-meta">
              <span class="label">{e.period}</span>
              <span class="muted">{e.place}</span>
              {e.current && <span class="pill"><span class="dot pulse"></span>Current</span>}
            </div>
            <div>
              <h3 class="h3">{e.role}</h3>
              <p class="company">{e.company}</p>
              <p class="muted summary">{e.summary}</p>
              <ul class="points">{e.points.map((pt) => <li>{pt}</li>)}</ul>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="section ui-grid split" aria-label="Education and achievements">
      <div data-reveal>
        <SectionHead size="sub" label="Education" title="Studied." split={false} />
        <ul class="rows">
          {education.map((e) => <li><div><span><b>{e.degree}</b><br /><span class="muted">{e.school} · {e.note}</span></span><span class="label">{e.period}</span></div></li>)}
        </ul>
      </div>
      <div data-reveal>
        <SectionHead size="sub" label="Achievements" title="Recognised." split={false} />
        <ul class="rows">
          {achievements.map((a) => <li><div><span>{a}</span></div></li>)}
        </ul>
      </div>
    </section>

    <section class="section" aria-labelledby="sk-h">
      <SectionHead id="sk-h" size="sub" label="Skills" title="The toolbox." />
      <dl class="ui-card lg skills" data-reveal>
        {skills.map((g) => (
          <div class="skill-row">
            <dt class="label">{g.group}</dt>
            <dd class="pills">{g.items.map((s) => <span class="chip">{s}</span>)}</dd>
          </div>
        ))}
      </dl>
    </section>

    {recommendations.length > 0 && (
      <section class="section" aria-labelledby="rec-h">
        <SectionHead id="rec-h" size="sub" label="Recommendations · LinkedIn" title="In their words." />
        <div class="quotes">{recommendations.map((r) => <Quote r={r} />)}</div>
      </section>
    )}
  </div>
</Base>

<style>
  .about-head { display: grid; grid-template-columns: 1.3fr .9fr; gap: clamp(32px, 6vw, 96px); align-items: end; }
  .about-head :global(.shead) { margin-bottom: 24px; }
  .ctas { margin-top: 32px; }
  .photo { margin: 0; justify-self: center; text-align: center; }
  .photo :global(img) {
    width: min(380px, 80vw); height: auto;
    background: radial-gradient(70% 60% at 50% 45%, var(--accent-soft), transparent 70%);
    -webkit-mask-image: linear-gradient(#000 78%, transparent); mask-image: linear-gradient(#000 78%, transparent);
  }
  .photo .label { margin-top: 6px; }

  .jobs { list-style: none; margin: 0; padding: 0; }
  .job { display: grid; grid-template-columns: 220px 1fr; gap: 32px; }
  .job-meta { display: flex; flex-direction: column; align-items: flex-start; gap: 8px; }
  .company { color: var(--accent); margin: 6px 0 12px; font-weight: 500; }
  .summary { margin-bottom: 16px; }
  .points { margin: 0; padding-left: 18px; color: var(--text-2); }
  .points li + li { margin-top: 8px; }
  .points li::marker { color: var(--accent); }

  .split { grid-template-columns: 1fr 1fr; gap: 48px; }
  .split .rows > li > div { align-items: flex-start; }

  .skills { margin: 0; padding-block: 8px; }
  .skill-row { display: grid; grid-template-columns: 200px 1fr; gap: 16px; padding: 16px 0; border-bottom: 1px solid var(--line); }
  .skill-row:last-child { border-bottom: 0; }
  .skill-row dt { padding-top: 5px; }
  .skill-row dd { margin: 0; }

  .quotes { columns: 2 340px; column-gap: var(--gap-grid); }

  @media (max-width: 900px) {
    .about-head, .split { grid-template-columns: 1fr; }
    .photo { order: -1; }
    .job { grid-template-columns: 1fr; gap: 12px; }
    .job-meta { flex-direction: row; flex-wrap: wrap; align-items: center; }
    .skill-row { grid-template-columns: 1fr; gap: 8px; }
  }
</style>
