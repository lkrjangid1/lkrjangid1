---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import SectionHead from '../../components/SectionHead.astro';
import { categoryLabels } from '../../data/site';
import { getWork } from '../../data/work';
import { sortedRepos, statusLabels } from '../../data/repos';
import { shotSrc } from '../../data/shots';

const { projects } = await getWork();

const repoCategory = (status: string) => (status === 'learning' ? 'learning' : status === 'flagship' ? 'tooling' : 'open-source');
const categories = [...new Set([...projects.map((p) => p.category), ...sortedRepos.map((r) => repoCategory(r.status))])];
const total = projects.length + sortedRepos.length;
---
<Base
  title="Work"
  current="/work"
  ogSlug="work"
  description={`${total} projects by Lokesh Jangid: fintech apps at Univest, Flutter tooling, indie apps with 600K+ downloads, and open-source experiments.`}
>
  <div class="wrap">
    <header class="page-head">
      <div class="page-glow" aria-hidden="true"></div>
      <SectionHead as="h1" label="Work" title="Things I've built" accent="and shipped." split={false}>
        <p class="lead" id="count" aria-live="polite">{total} projects</p>
      </SectionHead>
    </header>

    <div class="controls" id="filters">
      <label class="search">
        <span class="sr-only">Search projects</span>
        <Icon name="search" />
        <input type="search" id="q" placeholder="Search projects, stacks, metrics" autocomplete="off" />
      </label>
      <div class="chips" role="group" aria-label="Filter by category">
        <button type="button" class="fchip" data-c="" aria-pressed="true">All</button>
        {categories.map((c) => <button type="button" class="fchip" data-c={c} aria-pressed="false">{categoryLabels[c] ?? c}</button>)}
      </div>
    </div>

    <section class="group" aria-labelledby="pro-h">
      <SectionHead id="pro-h" size="sub" label={`${projects.length} projects`} title="Professional and products" />
      <div class="grid-cards">
        {projects.map((p) => (
          <ProjectCard
            slug={p.slug} href={`/work/${p.slug}`} title={p.name} subtitle={p.subtitle} meta={p.role}
            metric={p.metrics} tags={p.tech} category={p.category} featured={p.featured}
            shot={p.screenshots[0] ? shotSrc(p.screenshots[0]) : undefined}
          />
        ))}
      </div>
    </section>

    <section class="group" aria-labelledby="oss-h">
      <SectionHead id="oss-h" size="sub" label={`${sortedRepos.length} repositories`} title="Open source and experiments" />
      <div class="grid-cards">
        {sortedRepos.map((r) => (
          <ProjectCard
            slug={r.slug} href={r.caseStudy ? `/work/${r.slug}` : r.repo} external={!r.caseStudy}
            title={r.name} subtitle={r.desc} meta={`${r.year}`} tags={r.tech}
            status={statusLabels[r.status]} category={repoCategory(r.status)} featured={r.status === 'flagship'}
          />
        ))}
      </div>
    </section>

    <p class="empty muted" id="empty" hidden>No projects match. Try another filter.</p>
  </div>
</Base>

<script>
  const root = document.getElementById('filters')!;
  const input = document.getElementById('q') as HTMLInputElement;
  const chips = [...root.querySelectorAll<HTMLButtonElement>('.fchip')];
  const cards = [...document.querySelectorAll<HTMLElement>('.pcard')];
  const groups = [...document.querySelectorAll<HTMLElement>('.group')];
  const count = document.getElementById('count')!;
  const empty = document.getElementById('empty')!;
  const total = cards.length;

  const params = new URLSearchParams(location.search);
  let c = params.get('c') ?? '';
  let q = params.get('q') ?? '';
  if (!chips.some((b) => b.dataset.c === c)) c = '';
  input.value = q;

  function apply() {
    const terms = q.toLowerCase().split(/\s+/).filter(Boolean);
    let shown = 0;
    for (const card of cards) {
      const hay = card.dataset.search ?? '';
      const ok = (!c || card.dataset.category === c) && terms.every((t) => hay.includes(t));
      card.hidden = !ok;
      if (ok) shown++;
    }
    for (const g of groups) g.hidden = !g.querySelector('.pcard:not([hidden])');
    for (const b of chips) b.setAttribute('aria-pressed', String(b.dataset.c === c));
    empty.hidden = shown > 0;
    count.textContent = shown === total ? `${total} projects` : `${shown} of ${total} projects`;
    const url = new URL(location.href);
    if (c) url.searchParams.set('c', c); else url.searchParams.delete('c');
    if (q) url.searchParams.set('q', q); else url.searchParams.delete('q');
    history.replaceState(null, '', url);
  }

  chips.forEach((b) => b.addEventListener('click', () => { c = b.dataset.c ?? ''; apply(); }));
  input.addEventListener('input', () => { q = input.value.trim(); apply(); });
  apply();
</script>

<style>
  .controls { position: sticky; top: 72px; z-index: 5; display: flex; flex-wrap: wrap; gap: 12px; align-items: center; margin-bottom: var(--gap-head); padding: 10px; border-radius: var(--r-card); background: var(--glass); border: 1px solid var(--line); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); }
  .search { flex: 1 1 260px; display: flex; align-items: center; gap: 10px; padding: 0 16px; border-radius: var(--r-pill); background: var(--surface); border: 1px solid var(--line-2); color: var(--text-3); }
  .search:focus-within { outline: 2px solid var(--accent); outline-offset: 2px; }
  .search input { flex: 1; min-width: 0; border: 0; background: transparent; padding: 12px 0; outline: none; font-size: 15px; }
  .chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .fchip { font-size: 13px; padding: 8px 14px; border-radius: var(--r-pill); border: 1px solid var(--line-2); background: transparent; color: var(--text-2); transition: background var(--t-fast), color var(--t-fast); }
  .fchip:hover { background: var(--surface-2); color: var(--text); }
  .fchip[aria-pressed='true'] { background: var(--accent); border-color: var(--accent); color: var(--accent-ink); }
  .group + .group { margin-top: clamp(72px, 9vw, 120px); }
  .empty { padding: 48px 0; text-align: center; }
</style>
