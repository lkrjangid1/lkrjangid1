---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { categoryLabels } from '../../data/site';
import { getWork } from '../../data/work';
import { sortedRepos, statusLabels } from '../../data/repos';

const { projects } = await getWork();

const repoCategory = (status: string) => (status === 'learning' ? 'learning' : status === 'flagship' ? 'tooling' : 'open-source');
const categories = [
  ...new Set([...projects.map((p) => p.category), ...sortedRepos.map((r) => repoCategory(r.status))]),
];
const total = projects.length + sortedRepos.length;
---
<Base
  title="Work"
  current="/work"
  ogSlug="work"
  description={`${total} projects by Lokesh Jangid: fintech apps at Univest, Flutter tooling, indie apps with 600K+ downloads, and open-source experiments.`}
>
  <div class="container">
    <header class="page-head">
      <h1>Work</h1>
      <p class="muted" id="count" aria-live="polite">{total} projects</p>
    </header>

    <div class="controls" id="filters" hidden>
      <label class="search">
        <span class="sr-only">Search projects</span>
        <Icon name="search" />
        <input type="search" id="q" placeholder="Search projects" autocomplete="off" />
      </label>
      <div class="chips" role="group" aria-label="Filter by category">
        <button type="button" class="chip" data-c="" aria-pressed="true">All</button>
        {categories.map((c) => (
          <button type="button" class="chip" data-c={c} aria-pressed="false">{categoryLabels[c] ?? c}</button>
        ))}
      </div>
    </div>

    <section class="group" aria-labelledby="pro-h">
      <h2 id="pro-h">Professional and products</h2>
      <div class="grid">
        {projects.map((p) => (
          <ProjectCard
            href={`/work/${p.slug}`}
            title={p.name}
            subtitle={p.subtitle}
            meta={p.role}
            metric={p.metrics}
            tags={p.tech}
            category={p.category}
          />
        ))}
      </div>
    </section>

    <section class="group" aria-labelledby="oss-h">
      <h2 id="oss-h">Open source and experiments</h2>
      <div class="grid">
        {sortedRepos.map((r) => (
          <ProjectCard
            href={r.caseStudy ? `/work/${r.slug}` : r.repo}
            external={!r.caseStudy}
            title={r.name}
            subtitle={r.desc}
            meta={`${r.year}`}
            tags={r.tech}
            status={statusLabels[r.status]}
            category={repoCategory(r.status)}
            variant={r.status === 'flagship' ? 'featured' : 'default'}
          />
        ))}
      </div>
    </section>

    <p class="empty muted" id="empty" hidden>No projects match. Try another filter.</p>
  </div>
</Base>

<script>
  const root = document.getElementById('filters')!;
  const input = document.getElementById('q') as HTMLInputElement;
  const chips = [...root.querySelectorAll<HTMLButtonElement>('.chip')];
  const cards = [...document.querySelectorAll<HTMLElement>('.project')];
  const groups = [...document.querySelectorAll<HTMLElement>('.group')];
  const count = document.getElementById('count')!;
  const empty = document.getElementById('empty')!;
  const total = cards.length;

  const params = new URLSearchParams(location.search);
  let c = params.get('c') ?? '';
  let q = params.get('q') ?? '';
  if (!chips.some((b) => b.dataset.c === c)) c = '';
  input.value = q;
  root.hidden = false;

  function apply() {
    const terms = q.toLowerCase().split(/\s+/).filter(Boolean);
    let shown = 0;
    for (const card of cards) {
      const hay = card.dataset.search ?? '';
      const ok = (!c || card.dataset.category === c) && terms.every((t) => hay.includes(t));
      card.hidden = !ok;
      if (ok) shown++;
    }
    for (const g of groups) g.hidden = !g.querySelector('.project:not([hidden])');
    for (const b of chips) b.setAttribute('aria-pressed', String(b.dataset.c === c));
    empty.hidden = shown > 0;
    count.textContent = shown === total ? `${total} projects` : `${shown} of ${total} projects`;

    const url = new URL(location.href);
    c ? url.searchParams.set('c', c) : url.searchParams.delete('c');
    q ? url.searchParams.set('q', q) : url.searchParams.delete('q');
    history.replaceState(null, '', url);
  }

  chips.forEach((b) => b.addEventListener('click', () => { c = b.dataset.c ?? ''; apply(); }));
  input.addEventListener('input', () => { q = input.value.trim(); apply(); });
  apply();
</script>

<style>
  .controls { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; margin-bottom: var(--space-8); }
  .search {
    flex: 1 1 240px; display: flex; align-items: center; gap: 8px; padding: 0 12px;
    background: var(--surface-2); border: 1px solid var(--border-strong); border-radius: var(--radius); color: var(--text-muted);
  }
  .search:focus-within { outline: 2px solid var(--accent); outline-offset: 2px; }
  .search input { flex: 1; border: 0; background: transparent; padding: 9px 0; outline: none; font-size: 15px; min-width: 0; }
  .chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .chip {
    font-size: 13px; padding: 6px 12px; border-radius: var(--radius); cursor: pointer;
    border: 1px solid var(--border-strong); background: transparent; color: var(--text-secondary);
  }
  .chip:hover { background: var(--surface-1); color: var(--text-primary); }
  .chip[aria-pressed='true'] { background: var(--bg-accent); color: var(--text-accent); border-color: var(--accent); }
  .group + .group { margin-top: var(--space-12); }
  .group h2 { margin-bottom: var(--space-4); }
  .empty { padding: var(--space-8) 0; }
</style>
