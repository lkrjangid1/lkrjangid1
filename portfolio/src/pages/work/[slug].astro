---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import AppIcon from '../../components/AppIcon.astro';
import Device from '../../components/Device.astro';
import Shot from '../../components/Shot.astro';
import { getWork, type CaseStudy } from '../../data/work';
import type { Project } from '../../data/projects';
import { categoryLabels, framedShots, site } from '../../data/site';
import { shotSrc } from '../../data/shots';
import { brand } from '../../data/icons';
import SectionHead from '../../components/SectionHead.astro';
import { ids } from '../../data/seo';

export async function getStaticPaths() {
  const { projects, caseStudies } = await getWork();
  const bySlug = new Map(caseStudies.map((c) => [c.id, c]));
  const items = projects.map((p) => ({ slug: p.slug, project: p as Project | undefined, study: bySlug.get(p.slug) }));
  for (const c of caseStudies) {
    if (!projects.some((p) => p.slug === c.id)) items.push({ slug: c.id, project: undefined, study: c });
  }
  // Case studies first (in their configured order), then the remaining projects.
  items.sort((a, b) => (a.study?.data.order ?? 99) - (b.study?.data.order ?? 99));
  const related = (item: (typeof items)[number]) => {
    const cat = item.project?.category;
    const others = projects.filter((p) => p.slug !== item.slug);
    return [...others.filter((p) => p.category === cat), ...others.filter((p) => p.category !== cat)]
      .slice(0, 3).map((p) => ({ slug: p.slug, name: p.name, subtitle: p.subtitle }));
  };
  return items.map((item, i) => ({ params: { slug: item.slug }, props: { ...item, next: items[(i + 1) % items.length], related: related(item) } }));
}

interface Item {
  slug: string;
  project?: Project;
  study?: CaseStudy;
}
type Props = Item & { next: Item; related: { slug: string; name: string; subtitle: string }[] };

const { slug, project, study, next, related } = Astro.props;
const Content = study ? (await render(study)).Content : undefined;

const name = study?.data.title ?? project!.name;
const headline = study?.data.headline ?? project?.subtitle ?? '';
const summary = study?.data.summary ?? project?.points[0] ?? '';
const role = study?.data.role ?? project?.role;
const stack = study?.data.stack ?? project?.tech ?? [];
const links = [...(study?.data.links ?? []), ...(project?.links ?? [])].filter((l, i, all) => all.findIndex((x) => x.url === l.url) === i);
const nextName = next.study?.data.title ?? next.project?.name ?? next.slug;
const shots = (project?.screenshots ?? []).map(shotSrc);
const portrait = shots[0] && typeof shots[0] !== 'string' && shots[0].height > shots[0].width * 1.2;
const metrics = (project?.metrics ?? '').split(/\s+·\s+/).filter(Boolean);
const points = study ? project?.points ?? [] : (project?.points ?? []).slice(1);
const blocks = study
  ? [
      { title: 'Problem', body: study.data.problem },
      { title: 'Approach', body: study.data.approach },
      { title: 'Result', body: study.data.result },
    ]
  : [];

// Schema: apps with store listings are applications; code-first projects are source code; the rest creative works.
const storeOs: [RegExp, string][] = [[/play store|google play/i, 'Android'], [/(?<!mac )app store/i, 'iOS'], [/mac app store/i, 'macOS'], [/chrome web store/i, 'Chrome']];
const platforms = [...new Set(links.flatMap((l) => storeOs.filter(([re]) => re.test(l.label)).map(([, os]) => os)))];
const appCategory: Record<string, string> = {
  univest: 'FinanceApplication', scalper: 'FinanceApplication', 'finsight-ai': 'FinanceApplication', 'oi-visualizer': 'FinanceApplication',
  libgen: 'ReferenceApplication', searchly: 'UtilitiesApplication', 'remote-jobs': 'BusinessApplication', 'mbm-e-learning': 'EducationalApplication',
  'incognito-vault': 'UtilitiesApplication', pushpatch: 'DeveloperApplication',
};
const pageUrl = new URL(`/work/${slug}`, site.url).href;
const repo = study?.data.repo ?? links.find((l) => /github\.com/.test(l.url))?.url;
const common = { '@id': `${pageUrl}#project`, name, description: summary, url: pageUrl, author: { '@id': ids.person }, creator: { '@id': ids.person }, keywords: stack.join(', ') };
const jsonLd = platforms.length
  ? {
      '@type': platforms.every((p) => p === 'Android' || p === 'iOS') ? 'MobileApplication' : 'SoftwareApplication',
      ...common,
      operatingSystem: platforms.join(', '),
      applicationCategory: appCategory[slug] ?? 'UtilitiesApplication',
      offers: { '@type': 'Offer', price: 0, priceCurrency: 'INR' },
      sameAs: links.map((l) => l.url),
    }
  : repo
    ? { '@type': 'SoftwareSourceCode', ...common, codeRepository: repo, programmingLanguage: stack }
    : { '@type': 'CreativeWork', ...common, ...(links.length ? { sameAs: links.map((l) => l.url) } : {}) };

// Search-facing labels: "Flutter app" when built with Flutter, else the platform or main tech.
const has = (re: RegExp) => stack.some((t) => re.test(t));
const [kind, kindNoun] = has(/flutter/i) ? ['Flutter', '']
  : has(/chrome extension/i) ? ['Chrome Extension', ' ']
  : has(/swift/i) && has(/kotlin/i) ? ['Android & iOS', '']
  : has(/swift/i) ? ['iOS', ''] : has(/kotlin/i) ? ['Android', '']
  : has(/^(html|css|javascript|react)$/i) ? ['Web', '']
  : has(/langchain|gpt|llm|gemini/i) ? ['AI', '']
  : [stack[0] ?? '', ''];
// kindNoun ' ' means the kind already names the thing ("Chrome Extension"), so skip "App/Project".
const noun = kindNoun === ' ' ? '' : platforms.length || /app/i.test(headline) ? 'App' : 'Project';
const tidy = (s: string) => s.replace(/\s+/g, ' ').trim();
// Drop "Case Study" rather than cut mid-phrase when the name is long (44 = 60 − " · Lokesh Jangid").
const seoTitle = [`${name}: ${kind} ${noun} Case Study`, `${name}: ${kind} ${noun}`, name].map(tidy).find((t) => t.length <= 44) ?? name;
const seoDesc = [`${name}, ${/^[AEIOU]/.test(kind) ? 'an' : 'a'} ${tidy(`${kind} ${noun.toLowerCase()}`)} by Flutter developer ${site.name}.`, summary, metrics[0] ?? ''].filter(Boolean).join(' ');

const facts = [
  role && { k: 'Role', v: role },
  stack.length > 0 && { k: 'Stack', v: stack.join(', ') },
  platforms.length > 0 && { k: 'Available on', v: platforms.join(' · ') },
  metrics.length > 0 && { k: 'Impact', v: metrics.join(' · ') },
  study?.data.year && { k: 'Year', v: study.data.year },
].filter(Boolean) as { k: string; v: string }[];
---
<Base title={seoTitle} current="/work" ogSlug={`work-${slug}`} crumbs={{ [slug]: name }}
  keywords={[`${name} app`, tidy(`${kind} ${noun.toLowerCase()}`), ...stack.slice(0, 5), 'Flutter developer portfolio']}
  description={seoDesc} jsonLd={jsonLd} ogType={platforms.length ? 'website' : 'article'}>
  <article class="wrap" style={`--app:${brand(slug, name).accent}`}>
    <header class:list={['page-head', 'hero', { 'with-visual': shots.length > 0 }]}>
      <div class="app-glow" aria-hidden="true"></div>
      <div class="hero-copy">
        <nav class="crumb label" aria-label="Breadcrumb"><a href="/work">Work</a> <span aria-hidden="true">/</span> <span aria-current="page">{name}</span></nav>
        <div class="title-row">
          <AppIcon slug={slug} name={name} size={72} />
          <div>
            <p class="label">{project ? categoryLabels[project.category] ?? project.category : 'Open source'}{study?.data.year && ` · ${study.data.year}`}</p>
            <p class="app-name">{name}</p>
          </div>
        </div>
        <h1 class="h2 headline" data-split>{headline || name}</h1>
        {summary && <p class="lead">{summary}</p>}
        <div class="pills meta">
          {role && <span class="pill">{role}</span>}
          {stack.map((s) => <span class="chip">{s}</span>)}
        </div>
        {metrics.length > 0 && <ul class="metrics">{metrics.map((m) => <li>{m}</li>)}</ul>}
        {links.length > 0 && (
          <div class="btns links">
            {links.map((l, i) => <a class:list={['btn', { 'btn-primary': i === 0 }]} href={l.url} rel="noopener" data-cursor="Visit">{l.label} ↗</a>)}
          </div>
        )}
      </div>
      {shots.length > 0 && (
        <div class="hero-visual" data-reveal>
          {portrait && framedShots.has(slug)
            ? <Shot src={shots[0]} alt={`${name} screen`} width={640} class="poster-hero" eager />
            : portrait
            ? <Device kind="phone" size="big" shots={shots.slice(0, 6)} alt={`${name} screens`} eager />
            : <Device kind="browser" shots={shots.slice(0, 4)} alt={`${name} screens`} eager url={links.find((l) => /website|live|site/i.test(l.label))?.url.replace(/^https?:\/\//, '') ?? `${slug}`} />}
        </div>
      )}
    </header>

    {blocks.length > 0 && (
      <section class="ui-grid pac" aria-label="Problem, approach and result">
        {blocks.map((b, i) => (
          <div class="ui-card glow block" data-reveal>
            <span class="mono step">0{i + 1}</span>
            <h2 class="h3">{b.title}</h2>
            <p class="muted">{b.body}</p>
          </div>
        ))}
      </section>
    )}

    {facts.length > 0 && (
      <section class="section" aria-labelledby="glance-h">
        <SectionHead id="glance-h" size="sub" label="At a glance" title="Project facts" split={false} />
        <dl class="ui-card lg glance" data-reveal>
          {facts.map((f) => <div><dt class="label">{f.k}</dt><dd>{f.v}</dd></div>)}
        </dl>
      </section>
    )}

    {points.length > 0 && (
      <section class="section" aria-labelledby="built-h">
        <SectionHead id="built-h" size="sub" label="What I built" title="Highlights" />
        <ul class="ui-card lg points" data-reveal>{points.map((pt) => <li>{pt}</li>)}</ul>
      </section>
    )}

    {Content && (
      <section class="section narrow mdx">
        <Content />
      </section>
    )}

    {shots.length > 1 && (
      <section class="section" aria-labelledby="shots-h">
        <SectionHead id="shots-h" size="sub" label="Gallery" title="Screens" />
        <div class:list={['gallery', { portrait }]} tabindex="0" role="region" aria-label={`${name} screenshots, scrollable`} data-cursor="Drag">
          {shots.map((s, i) => <Shot src={s} alt={tidy(`${name} ${kind} ${noun.toLowerCase()} screenshot ${i + 1}`)} width={portrait ? 520 : 1200} />)}
        </div>
      </section>
    )}

    {related.length > 0 && (
      <section class="section" aria-labelledby="more-h">
        <SectionHead id="more-h" size="sub" label="Keep exploring" title="More projects" split={false} />
        <ul class="ui-grid more">
          {related.map((r) => (
            <li><a class="ui-card hoverable glow rel" href={`/work/${r.slug}`} style={`--app:${brand(r.slug, r.name).accent}`} data-cursor="Open">
              <AppIcon slug={r.slug} name={r.name} size={40} />
              <span><b>{r.name}</b>{r.subtitle && <span class="muted">{r.subtitle}</span>}</span>
            </a></li>
          ))}
        </ul>
      </section>
    )}

    <nav class="next" aria-label="Next project">
      <a href={`/work/${next.slug}`} data-cursor="Next">
        <span class="label">Next project</span>
        <span class="next-name"><AppIcon slug={next.slug} name={nextName} size={40} /> {nextName} <span aria-hidden="true">→</span></span>
      </a>
    </nav>
  </article>
</Base>

<style>
  .hero { display: grid; gap: clamp(32px, 6vw, 80px); align-items: center; }
  .hero.with-visual { grid-template-columns: minmax(0, 1.15fr) minmax(0, .85fr); }
  .app-glow { position: absolute; inset: -30% -30% auto; height: 720px; z-index: -1; pointer-events: none; background: radial-gradient(55% 50% at 60% 40%, color-mix(in srgb, var(--app) 22%, transparent), transparent 70%); }
  .crumb { margin-bottom: 28px; }
  .crumb a:hover { color: var(--text); }
  .title-row { display: flex; align-items: center; gap: 18px; margin-bottom: 24px; }
  .app-name { font: 600 22px/1.2 var(--font-display); letter-spacing: -.02em; margin-top: 6px; }
  .headline { max-width: 15ch; }
  .lead { margin-top: 24px; }
  .meta { margin-top: 24px; }
  .metrics { list-style: none; display: flex; flex-wrap: wrap; gap: 8px; margin: 20px 0 0; padding: 0; }
  .metrics li { padding: 7px 12px; border-radius: var(--r-pill); font-size: 13.5px; color: var(--text); background: color-mix(in srgb, var(--app) 12%, var(--surface-2)); border: 1px solid color-mix(in srgb, var(--app) 28%, transparent); }
  .links { margin-top: 28px; }
  .hero-visual { display: grid; place-items: center; }
  .hero-visual :global(.poster-hero) { width: min(320px, 80vw); height: auto; border-radius: var(--r-card); box-shadow: var(--shadow); }

  .pac { grid-template-columns: repeat(3, minmax(0, 1fr)); margin-top: var(--gap-head); }
  .step { color: var(--app); }
  .block .h3 { margin: 12px 0 8px; }

  .narrow { max-width: 820px; }
  .glance { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 24px 32px; margin: 0; }
  .glance dt { margin-bottom: 6px; }
  .glance dd { margin: 0; color: var(--text); font-size: 16px; line-height: 1.5; }
  .more { list-style: none; margin: 0; padding: 0; grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .rel { display: flex; align-items: center; gap: 14px; }
  .rel b { display: block; font-weight: 500; }
  .rel .muted { display: block; font-size: 14px; }
  @media (max-width: 900px) { .more { grid-template-columns: 1fr; } }
  .points { margin: 0; padding-left: calc(var(--pad-lg) + 20px); color: var(--text-2); font-size: 18px; max-width: 980px; }
  .points li + li { margin-top: 12px; }
  .points li::marker { color: var(--app); }

  .mdx { color: var(--text-2); }
  .mdx :global(h2) { font: 600 var(--fs-subtitle)/1 var(--font-display); letter-spacing: -.035em; color: var(--text); margin: clamp(64px, 8vw, 104px) 0 24px; }
  .mdx :global(h2:first-child) { margin-top: 0; }
  .mdx :global(p), .mdx :global(ul), .mdx :global(ol) { margin: 0 0 1em; }
  .mdx :global(li + li) { margin-top: 8px; }
  .mdx :global(strong) { color: var(--text); font-weight: 500; }
  .mdx :global(a) { color: var(--text); border-bottom: 1px solid var(--line-2); }
  .mdx :global(a:hover) { border-color: var(--accent); }
  .mdx :global(:not(pre) > code) { font-family: var(--font-mono); font-size: .88em; background: var(--surface-2); padding: 2px 6px; border-radius: 6px; }
  .mdx :global(.bench), .mdx :global(.codeblock) { border-radius: var(--r-card); }
  .mdx :global(figure), .mdx :global(.codeblock) { margin: 20px 0; }

  .gallery { display: flex; gap: var(--gap-grid); overflow-x: auto; padding-bottom: 10px; scroll-snap-type: x mandatory; }
  .gallery :global(img) { flex: none; height: 360px; width: auto; scroll-snap-align: start; border-radius: var(--r-card); border: 1px solid var(--line-2); background: var(--surface-2); }
  .gallery.portrait :global(img) { height: 520px; }

  .next { margin-top: clamp(96px, 12vw, 160px); border-top: 1px solid var(--line); }
  .next a { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 28px 0 0; }
  .next-name { display: inline-flex; align-items: center; gap: 14px; font: 600 clamp(22px, 2.6vw, 32px)/1.2 var(--font-display); letter-spacing: -.02em; }
  .next a:hover .next-name { color: var(--accent); }

  @media (max-width: 900px) {
    .hero.with-visual { grid-template-columns: 1fr; }
    .pac { grid-template-columns: 1fr; }
    .gallery :global(img) { height: 240px; }
    .gallery.portrait :global(img) { height: 420px; }
  }
</style>
