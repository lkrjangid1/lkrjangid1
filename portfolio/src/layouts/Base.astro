---
import '@fontsource/space-grotesk/latin-600.css';
import '@fontsource/fraunces/latin-400-italic.css';
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-500.css';
import '@fontsource/jetbrains-mono/latin-400.css';
import '../styles/global.css';
// Preloaded: the display face (hero name, headings) and body text paint first.
import displayFont from '@fontsource/space-grotesk/files/space-grotesk-latin-600-normal.woff2?url';
import bodyFont from '@fontsource/inter/files/inter-latin-400-normal.woff2?url';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  current?: string;
  ogSlug?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
}

const { title, description = site.description, current = '', ogSlug = 'home', jsonLd, noindex = false } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : `${site.name} · ${site.role}`;
// build.format 'file' makes pathname end in .html; Firebase serves clean URLs, so canonicalize to those.
const cleanPath = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '').replace(/\/$/, '') || '/';
const canonical = new URL(cleanPath, site.url).href;
const ogImage = new URL(`/og/${ogSlug}.png`, site.url).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline src="/theme-init.js"></script>
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#07080b" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#fafaf8" media="(prefers-color-scheme: light)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} — writing`} href="/rss.xml" />
    <slot name="head" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@lkrjangid" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body id="top">
    <div class="grain" aria-hidden="true"></div>
    <div class="cursor" aria-hidden="true"><div class="cursor-ring"></div><div class="cursor-dot"></div></div>
    <div class="cursor-tag" aria-hidden="true"><span class="cursor-label"></span></div>
    <a class="skip-link" href="#main">Skip to content</a>
    <Nav current={current} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/site.ts';
    </script>
  </body>
</html>
