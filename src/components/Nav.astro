---
import Icon from './Icon.astro';
import { nav, site } from '../data/site';

interface Props {
  current: string;
}
const { current } = Astro.props;
const isCurrent = (href: string) => current === href || current.startsWith(href + '/');
---
<header class="nav">
  <div class="container nav-inner">
    <a href="/" class="brand" aria-current={current === '/' ? 'page' : undefined}>{site.name}</a>

    <nav class="links" aria-label="Primary">
      {nav.map((item) => (
        <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
      ))}
    </nav>
    <a href="/contact" class="btn cta">Get in touch</a>

    <details class="menu">
      <summary aria-label="Menu"><Icon name="menu" size={20} /></summary>
      <nav class="menu-panel" aria-label="Mobile">
        {nav.map((item) => (
          <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
        ))}
        <a href="/contact" aria-current={isCurrent('/contact') ? 'page' : undefined}>Get in touch</a>
      </nav>
    </details>
  </div>
</header>

<style>
  .nav {
    position: sticky; top: 0; z-index: 10; height: var(--nav-h);
    background: color-mix(in srgb, var(--surface-0) 92%, transparent);
    backdrop-filter: saturate(1.4) blur(10px);
    -webkit-backdrop-filter: saturate(1.4) blur(10px);
    border-bottom: 1px solid var(--border);
  }
  .nav-inner { height: 100%; display: flex; align-items: center; gap: 24px; }
  .brand { color: var(--text-primary); font-weight: 500; text-decoration: none; font-size: 16px; }
  .links { display: flex; gap: 4px; margin-left: auto; }
  .links a, .menu-panel a {
    color: var(--text-secondary); text-decoration: none; font-size: 15px;
    padding: 6px 10px; border-radius: 6px;
  }
  .links a:hover, .menu-panel a:hover { color: var(--text-primary); background: var(--surface-1); }
  .links a[aria-current='page'], .menu-panel a[aria-current='page'] { color: var(--text-primary); background: var(--surface-1); }
  .cta { padding: 7px 14px; font-size: 14px; }

  .menu { display: none; margin-left: auto; position: relative; }
  .menu summary {
    list-style: none; cursor: pointer; padding: 8px; border-radius: var(--radius);
    border: 1px solid var(--border-strong); color: var(--text-primary); display: flex;
  }
  .menu summary::-webkit-details-marker { display: none; }
  .menu-panel {
    position: absolute; right: 0; top: calc(100% + 8px); min-width: 200px;
    display: flex; flex-direction: column; padding: 6px;
    background: var(--surface-2); border: 1px solid var(--border-strong); border-radius: var(--radius-card);
  }
  .menu-panel a { padding: 10px 12px; }

  @media (max-width: 768px) {
    .links, .cta { display: none; }
    .menu { display: block; }
  }
</style>
